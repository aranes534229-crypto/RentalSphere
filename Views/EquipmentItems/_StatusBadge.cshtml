@model string
@{
    // Centralizes the status -> text color mapping so the Index and Details
    // views don't repeat the same switch. "Available" renders as green text;
    // everything else (Reserved, CheckedOut, InMaintenance, Retired, etc.)
    // renders as red text. No badge/border/background — plain inline text.
    var cls = Model == "Available" ? "text-success" : "text-danger";
}
<span class="@cls">@Model</span>
