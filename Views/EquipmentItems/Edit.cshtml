@model RentalSphere.Modules.Equipment.Controllers.EquipmentItemEditViewModel
@{
    ViewData["Title"] = "Edit equipment unit";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var isStaffOnly = isStaff && !isAdmin;
    var unitIsRetired = Model.Form.AvailabilityStatus == "Retired";

    // For Staff, exclude "Retired" from the status options (Admin keeps the full list).
    var statusOptions = isAdmin
        ? Model.StatusOptions
        : Model.StatusOptions.Where(o => o.Value != "Retired").ToList();
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Equipment units</a></li>
        <li class="breadcrumb-item active">Edit @Model.Form.SerialNumber</li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">
        <h3 class="card-title"><i class="bi bi-pencil"></i> Edit @Model.Form.SerialNumber</h3>
        <p class="text-muted">Equipment: <strong>@Model.EquipmentName</strong></p>

        <div class="alert alert-info d-flex align-items-start" role="alert">
            <i class="bi bi-info-circle me-2 mt-1"></i>
            <div>
                Changing the availability status to or from <strong>Available</strong> automatically
                adjusts the parent equipment's <em>Stock quantity</em>. Other fields don't.
            </div>
        </div>

        @if (isStaffOnly)
        {
            <div class="alert alert-warning d-flex align-items-start" role="alert">
                <i class="bi bi-shield-lock me-2 mt-1"></i>
                <div>
                    As <strong>Staff</strong> you can change the availability status
                    (between Available, Reserved, Checked Out, and In Maintenance)
                    and the location. <strong>Retiring</strong> a unit, <strong>restoring</strong>
                    a Retired unit, or <strong>editing the serial</strong> requires an Admin.
                </div>
            </div>
        }

        <form asp-action="Edit" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.ItemID" />
            @if (!string.IsNullOrEmpty(returnUrl))
            {
                <input type="hidden" name="returnUrl" value="@returnUrl" />
            }
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row">
                @if (isAdmin)
                {
                    <div class="col-md-6 mb-3">
                        <label asp-for="Form.SerialNumber" class="form-label"></label>
                        <input asp-for="Form.SerialNumber" class="form-control" />
                        <span asp-validation-for="Form.SerialNumber" class="text-danger"></span>
                        <small class="form-text text-muted">Must be unique across all items. Auto-generated for new items based on the parent equipment's SerialPrefix.</small>
                    </div>
                }
                else
                {
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Serial number</label>
                        <input class="form-control" value="@Model.Form.SerialNumber" disabled readonly />
                        <small class="form-text text-muted">Read-only. Ask an Admin to change a serial (e.g. legacy typo fixups).</small>
                    </div>
                }
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.AvailabilityStatus" class="form-label"></label>
                    <select asp-for="Form.AvailabilityStatus" class="form-select" asp-items="@(new SelectList(statusOptions, "Value", "Text", Model.Form.AvailabilityStatus))">
                    </select>
                    @if (isStaffOnly && unitIsRetired)
                    {
                        <small class="text-warning d-block mt-1">
                            <i class="bi bi-exclamation-circle"></i>
                            This unit is currently Retired. Only an Admin can change its status back to an active state.
                        </small>
                    }
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Form.Location" class="form-label"></label>
                <input asp-for="Form.Location" class="form-control" placeholder="Warehouse A / Shelf 3" />
                <small class="form-text text-muted">Optional. Where the unit is stored when not rented.</small>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save</button>
            <a asp-action="Details" asp-route-id="@Model.Form.ItemID" asp-route-returnUrl="@returnUrl" class="btn btn-outline-secondary">Cancel</a>
        </form>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
