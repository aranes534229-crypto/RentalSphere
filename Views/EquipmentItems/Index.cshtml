@model RentalSphere.Modules.Equipment.Controllers.EquipmentItemsIndexViewModel
@{
    ViewData["Title"] = "Equipment units";
    var canWrite = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Staff);
    var canDelete = User.IsInRole(RoleNames.Admin);
    var isChildView = Model.EquipmentID.HasValue;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
        || Model.EquipmentID.HasValue
        || Model.CategoryId.HasValue
        || !string.IsNullOrWhiteSpace(Model.StatusFilter);

    var statusPills = new (string Label, string Value, string BgClass)[]
    {
        ("All",        "",               "bg-secondary"),
        ("Available",  "Available",      "bg-success"),
        ("Reserved",   "Reserved",       "bg-warning text-dark"),
        ("Checked Out","CheckedOut",     "bg-warning text-dark"),
        ("In Maint.",  "InMaintenance",  "bg-danger"),
        ("Retired",    "Retired",        "bg-secondary"),
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-upc-scan"></i> Equipment units</h2>
        <small class="text-muted">
            @if (isChildView)
            {
                <text>Units tracked for a specific equipment type.</text>
            }
            else
            {
                <text>One row per equipment type. Click a row to drill into its items.</text>
            }
        </small>
    </div>
    @if (canWrite)
    {
        <a asp-action="Create" asp-route-equipmentId="@Model.EquipmentID" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add unit
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-3">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="@(isChildView ? "Search by serial number..." : "Search by name or serial...")" />
        </div>
        <div class="col-md-2">
            <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.CategoryLookup, "Value", "Text", Model.CategoryId))">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="equipmentId" class="form-select" asp-items="@(new SelectList(Model.EquipmentLookup, "Value", "Text", Model.EquipmentID))">
                <option value="">All equipment</option>
            </select>
        </div>
        @if (isChildView)
        {
            <div class="col-md-2">
                <select name="status" class="form-select" asp-items="@(new SelectList(Model.StatusOptions, "Value", "Text", Model.StatusFilter))">
                </select>
            </div>
            <div class="col-md-3 d-flex gap-1">
                <button class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> Filter</button>
                @if (hasFilter)
                {
                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        }
        else
        {
            <div class="col-md-5 d-flex gap-1">
                <button class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> Filter</button>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
                }
            </div>
        }
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

@if (isChildView)
{
    <ul class="nav nav-pills mb-3 gap-1">
        @foreach (var p in statusPills)
        {
            var isActive = (Model.StatusFilter ?? "") == p.Value;
            var link = Url.Action("Index", new
            {
                search = Model.Search,
                equipmentId = Model.EquipmentID,
                categoryId = Model.CategoryId,
                status = p.Value,
                page = 1
            });
            <li class="nav-item">
                <a class="nav-link @(isActive ? "active text-white" : "text-dark") @(isActive ? p.BgClass : "")"
                   style="@(isActive ? "" : "background-color: #f1f3f5;")"
                   href="@link">
                    @p.Label
                </a>
            </li>
        }
    </ul>
}

@if (isChildView)
{
    @* Flat child list — drill-in branch. *@
    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        @* ponytail: sort wiring pending; this header is decorative until the service adds a `sort` param. *@
                        <th>Serial #</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th>Last change</th>
                        @if (canWrite)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@(canWrite ? 5 : 4)" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No items match your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@i.ItemID"><code>@i.SerialNumber</code></a></td>
                            <td><partial name="_StatusBadge" model="i.AvailabilityStatus" /></td>
                            <td><small class="text-muted">@(i.Location ?? "—")</small></td>
                            <td><small>@(i.LastStatusChange?.ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                            @if (canWrite)
                            {
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@i.ItemID" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    @if (canDelete)
                                    {
                                        <a asp-action="Delete" asp-route-id="@i.ItemID" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s")
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="card-footer text-muted small">
                Showing @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s")
            </div>
        }
    </div>
}
else
{
    @* Parent table — default view. Paging operates on parent rows. *@
    @if (!Model.Parents.Any())
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-x-lg"></i> Reset filters
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Equipment</th>
                            <th>Category</th>
                            <th class="text-end">Daily rate</th>
                            <th class="text-end">Items</th>
                            <th>Status breakdown</th>
                            <th>Catalog status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Parents)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Index" asp-route-equipmentId="@p.EquipmentID"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="1"
                                       class="fw-semibold text-decoration-none">
                                        @p.Name
                                    </a>
                                </td>
                                <td><small class="text-muted">@p.CategoryName</small></td>
                                <td class="text-end">&#8369;@p.DailyRate.ToString("N2")</td>
                                <td class="text-end">@p.TotalCount</td>
                                <td>
                                    <span class="badge bg-success me-1">@p.AvailableCount Avail</span>
                                    @if (p.ReservedCount   > 0) { <span class="badge bg-warning text-dark me-1">@p.ReservedCount Rsv</span> }
                                    @if (p.CheckedOutCount > 0) { <span class="badge bg-warning text-dark me-1">@p.CheckedOutCount Out</span> }
                                    @if (p.MaintCount      > 0) { <span class="badge bg-danger me-1">@p.MaintCount Mx</span> }
                                    @if (p.RetiredCount    > 0) { <span class="badge bg-secondary me-1">@p.RetiredCount Ret</span> }
                                </td>
                                <td><partial name="_StatusBadge" model="p.Status" /></td>
                                <td class="text-end">
                                    <a asp-action="Index" asp-route-equipmentId="@p.EquipmentID"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-search="@Model.Search"
                                       class="btn btn-sm btn-outline-primary" title="View items">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                        of @Model.TotalCount equipment group@(Model.TotalCount == 1 ? "" : "s")
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
            else if (Model.TotalCount > 0)
            {
                <div class="card-footer text-muted small">
                    Showing @Model.TotalCount equipment group@(Model.TotalCount == 1 ? "" : "s")
                </div>
            }
        </div>
    }
}
