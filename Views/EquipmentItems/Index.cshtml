@model RentalSphere.Modules.Equipment.Controllers.EquipmentItemsIndexViewModel
@{
    ViewData["Title"] = "Equipment units";
    var canWrite = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Staff);
    var canDelete = User.IsInRole(RoleNames.Admin);
    var isChildView = Model.EquipmentID.HasValue;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search)
        || Model.EquipmentID.HasValue
        || Model.CategoryId.HasValue
        || !string.IsNullOrWhiteSpace(Model.StatusFilter);

    var statusPills = new (string Label, string Value)[]
    {
        ("All",        ""),
        ("Available",  "Available"),
        ("Reserved",   "Reserved"),
        ("Checked Out","CheckedOut"),
        ("In Maint.",  "InMaintenance"),
        ("Retired",    "Retired"),
    };
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-upc-scan"></i> Equipment units</h2>
        <small class="text-muted">
            @if (isChildView)
            {
                <text>Units tracked for a specific equipment type.</text>
            }
            else
            {
                <text>One row per equipment type. Click a row to drill into its items.</text>
            }
        </small>
    </div>
    @if (canWrite)
    {
        <a asp-action="Create" asp-route-equipmentId="@Model.EquipmentID" class="btn equipment-add-btn">
            <i class="bi bi-plus-circle"></i> Add unit
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 equipment-filter-form" id="equipmentItemsFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-3">
            <input type="text" name="search" value="@Model.Search" class="form-control equipment-filter-control" placeholder="@(isChildView ? "Search by serial number..." : "Search by name or serial...")" />
        </div>
        <div class="col-md-2">
            <select name="categoryId" class="form-select equipment-filter-control" asp-items="@(new SelectList(Model.CategoryLookup, "Value", "Text", Model.CategoryId))">
                <option value="">All categories</option>
            </select>
        </div>
        @if (!isChildView)
        {
            <div class="col-md-3">
                <select name="equipmentId" class="form-select equipment-filter-control" asp-items="@(new SelectList(Model.EquipmentLookup, "Value", "Text", Model.EquipmentID))">
                    <option value="">All equipment</option>
                </select>
            </div>
        }
        @if (isChildView)
        {
            <div class="col-md-2">
                <select name="status" class="form-select equipment-filter-control" asp-items="@(new SelectList(Model.StatusOptions, "Value", "Text", Model.StatusFilter))">
                </select>
            </div>
        }
        <div class="@(isChildView ? "col-md-2" : "col-md-4") d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="equipmentItemsPageSize" value="@Model.PageSize" />
</form>

@if (isChildView)
{
    <ul class="nav nav-pills mb-3 gap-1">
        @foreach (var p in statusPills)
        {
            var isActive = (Model.StatusFilter ?? "") == p.Value;
            var link = Url.Action("Index", new
            {
                search = Model.Search,
                equipmentId = Model.EquipmentID,
                categoryId = Model.CategoryId,
                status = p.Value,
                page = 1,
                pageSize = Model.PageSize
            });
            <li class="nav-item">
                <a class="nav-link @(isActive ? "active text-success" : "text-dark")"
                   href="@link">
                    @p.Label
                </a>
            </li>
        }
    </ul>

    <div class="equipment-main-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle equipment-table">
                <thead class="equipment-table-header">
                    <tr>
                        @* ponytail: sort wiring pending; this header is decorative until the service adds a `sort` param. *@
                        <th>Serial #</th>
                        <th>Status</th>
                        <th>Location</th>
                        <th>Last change</th>
                        @if (canWrite)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@(canWrite ? 5 : 4)" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No items match your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" asp-route-categoryId="@Model.CategoryId" asp-route-equipmentId="@Model.EquipmentID" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var i in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@i.ItemID" class="equipment-name-link"><code>@i.SerialNumber</code></a></td>
                            <td><partial name="_StatusBadge" model="i.AvailabilityStatus" /></td>
                            <td><small class="text-muted">@(i.Location ?? "—")</small></td>
                            <td><small>@(i.LastStatusChange?.ToString("yyyy-MM-dd HH:mm") ?? "—")</small></td>
                            @if (canWrite)
                            {
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link p-0 equipment-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end equipment-popout">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@i.ItemID"><i class="bi bi-eye me-2"></i>View details</a></li>
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@i.ItemID"><i class="bi bi-pencil me-2"></i>Edit unit</a></li>
                                            @if (canDelete)
                                            {
                                                <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@i.ItemID"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('equipmentItemsPageSize').value = this.value; document.getElementById('equipmentFilterForm').submit();">
                        @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                        @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                        @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                        @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                    </select>
                </div>
                <div class="d-flex align-items-center">
                    <small class="text-muted me-3 mb-0">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                        of @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s")
                    </small>
                    <nav>
                        <div class="d-flex align-items-center equipment-pagination" style="gap: 6px;">
                            <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                            <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                if (p == Model.Page)
                                {
                                    <a class="pagination-pill active" href="#">@p</a>
                                }
                                else
                                {
                                    <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                                }
                            }
                            <span class="pagination-ellipsis" aria-hidden="true">…</span>
                            <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                            <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                        </div>
                    </nav>
                </div>
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="card-footer text-muted small">
                Showing @Model.TotalCount item@(Model.TotalCount == 1 ? "" : "s")
            </div>
        }
    </div>
}
else
{
    @* Parent table — default view. Paging operates on parent rows. *@
    @if (!Model.Parents.Any())
    {
        <div class="equipment-main-card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-x-lg"></i> Reset filters
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="equipment-main-card">
            <div class="table-responsive">
                <table class="table table-hover align-middle equipment-table">
                    <thead class="equipment-table-header">
                        <tr>
                            <th>Equipment</th>
                            <th>Category</th>
                            <th class="text-end">Daily rate</th>
                            <th class="text-end">Items</th>
                            <th>Status breakdown</th>
                            <th>Catalog status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.Parents)
                        {
                            <tr>
                                <td>
                                    <a asp-action="Index" asp-route-equipmentId="@p.EquipmentID"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-search="@Model.Search"
                                       asp-route-page="1"
                                       asp-route-pageSize="@Model.PageSize"
                                       class="equipment-name-link fw-semibold">@p.Name</a>
                                </td>
                                <td><small class="text-muted">@p.CategoryName</small></td>
                                <td class="text-end">&#8369;@p.DailyRate.ToString("N2")</td>
                                <td class="text-end">@p.TotalCount</td>
                                <td>
                                    @{
                                        // Status breakdown: green text for Available, red text for
                                        // Reserved/Checked Out/In Maintenance/Retired. No badges.
                                        var green = "text-success";
                                        var red   = "text-danger";
                                    }
                                    <span class="@green">@p.AvailableCount Avail</span>
                                    @if (p.ReservedCount   > 0) { <span class="@red">@p.ReservedCount Rsv</span> }
                                    @if (p.CheckedOutCount > 0) { <span class="@red">@p.CheckedOutCount Out</span> }
                                    @if (p.MaintCount      > 0) { <span class="@red">@p.MaintCount Mx</span> }
                                    @if (p.RetiredCount    > 0) { <span class="@red">@p.RetiredCount Ret</span> }
                                </td>
                                <td><partial name="_StatusBadge" model="p.Status" /></td>
                                <td class="text-end">
                                    <a asp-action="Index" asp-route-equipmentId="@p.EquipmentID"
                                       asp-route-categoryId="@Model.CategoryId"
                                       asp-route-search="@Model.Search"
                                       asp-route-pageSize="@Model.PageSize"
                                       class="btn btn-sm equipment-action-btn" title="View items" data-bs-toggle="tooltip">
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalPages > 1)
            {
                <div class="card-footer d-flex justify-content-between align-items-center py-3">
                    <div class="d-flex align-items-center">
                        <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                        <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('equipmentItemsPageSize').value = this.value; document.getElementById('equipmentItemsFilterForm').submit();">
                            @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                            @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                            @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                            @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                        </select>
                    </div>
                    <div class="d-flex align-items-center">
                        <small class="text-muted me-3 mb-0">
                            Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                            of @Model.TotalCount equipment group@(Model.TotalCount == 1 ? "" : "s")
                        </small>
                        <nav>
                            <div class="d-flex align-items-center equipment-pagination" style="gap: 6px;">
                                <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                                <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                                @for (var p = 1; p <= Model.TotalPages; p++)
                                {
                                    if (p == Model.Page)
                                    {
                                        <a class="pagination-pill active" href="#">@p</a>
                                    }
                                    else
                                    {
                                        <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                                    }
                                }
                                <span class="pagination-ellipsis" aria-hidden="true">…</span>
                                <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                                <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                            </div>
                        </nav>
                    </div>
                </div>
            }
            else if (Model.TotalCount > 0)
            {
                <div class="card-footer text-muted small">
                    Showing @Model.TotalCount equipment group@(Model.TotalCount == 1 ? "" : "s")
                </div>
            }
        </div>
    }
}