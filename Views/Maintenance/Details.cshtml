@model RentalSphere.Modules.Maintenance.ViewModels.MaintenanceDetailsViewModel
@{
    ViewData["Title"] = $"Maintenance #{Model.Record.MaintenanceRecordID}";
    var r = Model.Record;
    var statusClass = r.Status switch
    {
        "InProgress" => "bg-warning text-dark",
        "Completed" => "bg-success",
        _ => "bg-secondary",
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Maintenance</a></li>
        <li class="breadcrumb-item active">#@r.MaintenanceRecordID</li>
    </ol>
</nav>

@if (TempData["Success"] is string succ) { <div class="alert alert-success">@succ</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h3 class="card-title mb-0">Maintenance #@r.MaintenanceRecordID</h3>
                    <span class="badge @statusClass fs-6">@r.Status</span>
                </div>
                <p class="text-muted mb-3">@r.EquipmentName · <code>@r.SerialNumber</code></p>

                <dl class="row">
                    <dt class="col-sm-3">Reason</dt>
                    <dd class="col-sm-9">@r.Reason</dd>
                    <dt class="col-sm-3">Started</dt>
                    <dd class="col-sm-9">@r.StartedAt.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(r.OpenedByUserName) ? "" : $" by {r.OpenedByUserName}")</dd>
                    <dt class="col-sm-3">Expected end</dt>
                    <dd class="col-sm-9">@(r.ExpectedEnd?.ToString("yyyy-MM-dd") ?? "—")</dd>
                    @if (r.EndedAt.HasValue)
                    {
                        <dt class="col-sm-3">Closed</dt>
                        <dd class="col-sm-9">@r.EndedAt.Value.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(r.ClosedByUserName) ? "" : $" by {r.ClosedByUserName}")</dd>
                    }
                    <dt class="col-sm-3">Cost</dt>
                    <dd class="col-sm-9">₱@r.Cost.ToString("N2")</dd>
                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                    {
                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9" style="white-space: pre-line">@r.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (r.Status == "InProgress")
        {
            @* Save estimate — keeps the ticket InProgress, just updates the
               assessment fields. Two separate forms so each submits to a
               different action (UpdateEstimate vs Close) without
               cross-contamination. The hidden MaintenanceRecordID is the
               only shared field; Cost / ExpectedEnd / Notes are submitted
               only when "Save estimate" is clicked. *@
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">Repair estimate</h5>
                    <p class="text-muted small mb-2">
                        Save the current assessment without closing the ticket. The unit
                        stays in maintenance until the record is closed.
                    </p>
                    <form asp-route-id="@r.MaintenanceRecordID" asp-action="UpdateEstimate" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CloseForm.MaintenanceRecordID" value="@r.MaintenanceRecordID" />

                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <label asp-for="CloseForm.Cost" class="form-label small">Repair cost (₱)</label>
                                <input asp-for="CloseForm.Cost" type="number" step="0.01" min="0"
                                       class="form-control form-control-sm" />
                                <span asp-validation-for="CloseForm.Cost" class="text-danger small"></span>
                            </div>
                            <div class="col-5">
                                <label asp-for="CloseForm.ExpectedEnd" class="form-label small">Expected completion</label>
                                <input asp-for="CloseForm.ExpectedEnd" type="date"
                                       class="form-control form-control-sm" />
                            </div>
                        </div>

                        <div class="mb-2">
                            <label asp-for="CloseForm.Notes" class="form-label small">Update note (optional)</label>
                            <textarea asp-for="CloseForm.Notes" class="form-control" rows="2"
                                      placeholder="What changed? Vendor quote, parts on order, etc."></textarea>
                        </div>
                        <button type="submit" class="btn btn-primary w-100">
                            <i class="bi bi-save"></i> Save estimate
                        </button>
                    </form>
                </div>
            </div>

            @* Close & restore — terminal action. Flips Status to Completed,
               stamps EndedAt, restores the unit to Available. Confirmation
               is via button label only; if you want a JS confirm() before
               this commits, that's a one-line addition. *@
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Close record</h5>
                    <p class="text-muted small mb-2">
                        Marks the ticket Completed and restores the unit to Available.
                    </p>
                    <form asp-route-id="@r.MaintenanceRecordID" asp-action="Close" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CloseForm.MaintenanceRecordID" value="@r.MaintenanceRecordID" />
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Close &amp; restore unit
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left"></i> Back to list</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
