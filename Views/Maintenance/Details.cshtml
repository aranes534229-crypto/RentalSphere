@model RentalSphere.Modules.Maintenance.ViewModels.MaintenanceDetailsViewModel
@{
    ViewData["Title"] = $"Maintenance #{Model.Record.MaintenanceRecordID}";
    var r = Model.Record;
    var statusClass = r.Status switch
    {
        "InProgress" => "bg-warning text-dark",
        "Completed" => "bg-success",
        _ => "bg-secondary",
    };
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Maintenance</a></li>
        <li class="breadcrumb-item active">#@r.MaintenanceRecordID</li>
    </ol>
</nav>

@if (TempData["Success"] is string succ) { <div class="alert alert-success">@succ</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="row">
    <div class="col-md-8">
        <div class="card mb-3">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h3 class="card-title mb-0">Maintenance #@r.MaintenanceRecordID</h3>
                    <span class="badge @statusClass fs-6">@r.Status</span>
                </div>
                <p class="text-muted mb-3">@r.EquipmentName · <code>@r.SerialNumber</code></p>

                <dl class="row">
                    <dt class="col-sm-3">Reason</dt>
                    <dd class="col-sm-9">@r.Reason</dd>
                    <dt class="col-sm-3">Started</dt>
                    <dd class="col-sm-9">@r.StartedAt.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(r.OpenedByUserName) ? "" : $" by {r.OpenedByUserName}")</dd>
                    <dt class="col-sm-3">Expected end</dt>
                    <dd class="col-sm-9">@(r.ExpectedEnd?.ToString("yyyy-MM-dd") ?? "—")</dd>
                    @if (r.EndedAt.HasValue)
                    {
                        <dt class="col-sm-3">Closed</dt>
                        <dd class="col-sm-9">@r.EndedAt.Value.ToString("yyyy-MM-dd HH:mm")@(string.IsNullOrEmpty(r.ClosedByUserName) ? "" : $" by {r.ClosedByUserName}")</dd>
                    }
                    <dt class="col-sm-3">Cost</dt>
                    <dd class="col-sm-9">₱@r.Cost.ToString("N2")</dd>
                    @if (!string.IsNullOrWhiteSpace(r.Notes))
                    {
                        <dt class="col-sm-3">Notes</dt>
                        <dd class="col-sm-9" style="white-space: pre-line">@r.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        @if (r.Status == "InProgress")
        {
            <div class="card">
                <div class="card-body">
                    <h5 class="card-title">Close record</h5>
                    <form asp-action="Close" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" asp-for="CloseForm.MaintenanceRecordID" />
                        <div class="mb-2">
                            <label asp-for="CloseForm.Notes" class="form-label small"></label>
                            <textarea asp-for="CloseForm.Notes" class="form-control" rows="3" placeholder="What was done?"></textarea>
                        </div>
                        <button type="submit" class="btn btn-success w-100">
                            <i class="bi bi-check-circle"></i> Close & restore unit
                        </button>
                    </form>
                </div>
            </div>
        }
        else
        {
            <div class="card">
                <div class="card-body">
                    <a asp-action="Index" class="btn btn-outline-secondary w-100"><i class="bi bi-arrow-left"></i> Back to list</a>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
