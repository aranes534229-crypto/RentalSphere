@model RentalSphere.Modules.Maintenance.ViewModels.MaintenanceIndexViewModel
@{
    ViewData["Title"] = "Maintenance";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-tools"></i> Maintenance</h2>
        <small class="text-muted d-block mt-1">
            Open tickets (units in repair) and closed records. Staff and Admin only.
        </small>
    </div>
    <a asp-action="Create" class="btn maintenance-add-btn">
        <i class="bi bi-plus-circle"></i> Open maintenance
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 maintenance-filter-form" id="maintenanceFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <select name="statusFilter" class="form-select maintenance-filter-control" id="maintenanceStatusSelect" asp-items="@(new SelectList(Model.Statuses, "Value", "Text", Model.StatusFilter))" onchange="this.form.submit();">
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="maintenancePageSize" value="@Model.PageSize" />
</form>

<div class="maintenance-main-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle maintenance-table">
            <thead class="maintenance-table-header">
                <tr>
                    <th>#</th>
                    <th>Equipment</th>
                    <th>Serial</th>
                    <th>Started</th>
                    <th>Expected</th>
                    <th>Closed</th>
                    <th>Reason</th>
                    <th class="text-end">Cost</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="p-0">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-tools" style="font-size: 2.5rem;"></i>
                            <p class="mb-1 mt-2">No maintenance records match your filters.</p>
                            @if (hasFilter)
                            {
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Show all
                                </a>
                            }
                        </div>
                    </td></tr>
                }
                @foreach (var m in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@m.MaintenanceRecordID" class="maintenance-name-link">#@m.MaintenanceRecordID</a></td>
                        <td>@m.EquipmentName</td>
                        <td><code>@m.SerialNumber</code></td>
                        <td><small>@m.StartedAt.ToString("yyyy-MM-dd")</small></td>
                        <td><small>@(m.ExpectedEnd?.ToString("yyyy-MM-dd") ?? "—")</small></td>
                        <td><small>@(m.EndedAt?.ToString("yyyy-MM-dd") ?? "—")</small></td>
                        <td>@m.Reason</td>
                        <td class="text-end">₱@m.Cost.ToString("N2")</td>
                        <td><partial name="_StatusBadge" model="m.Status" /></td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link p-0 maintenance-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end maintenance-popout">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@m.MaintenanceRecordID"><i class="bi bi-eye me-2"></i>Open</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <label for="maintenancePageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                <select id="maintenancePageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('maintenancePageSize').value = this.value; document.getElementById('maintenanceFilterForm').submit();">
                    @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                    @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                    @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                    @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                </select>
            </div>
            <nav>
                <div class="d-flex align-items-center maintenance-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="card-footer text-muted small">
            Showing @Model.TotalCount record@(Model.TotalCount == 1 ? "" : "s")
        </div>
    }
</div>
