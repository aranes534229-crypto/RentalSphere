@model RentalSphere.Modules.Maintenance.ViewModels.MaintenanceOpenViewModel
@{
    ViewData["Title"] = "Open maintenance";
    var hasCategories = Model.Categories.Count > 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Maintenance</a></li>
        <li class="breadcrumb-item active">Open</li>
    </ol>
</nav>

<h3 class="h4 mb-3"><i class="bi bi-tools"></i> Open maintenance record(s)</h3>
<p class="text-muted">Select one or more units. Each selected unit gets its own InProgress record and is pulled out of the Available pool until closed.</p>

<form asp-action="Create" method="post" id="maintenanceOpenForm">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-2"></div>

    <div class="row g-3">
        <div class="col-lg-8">
            @if (!hasCategories)
            {
                <div class="alert alert-info">No available units — every unit is already in maintenance, reserved, or retired.</div>
            }
            else
            {
                <div class="accordion" id="categoryAccordion">
                    @for (var c = 0; c < Model.Categories.Count; c++)
                    {
                        var cat = Model.Categories[c];
                        var collapseId = $"cat-{cat.CategoryID}";
                        var showCat = c == 0 ? "show" : null;
                        var expandedCat = c == 0 ? "true" : "false";
                        var totalUnitsInCat = cat.Equipment.Sum(e => e.Items.Count);
                        <div class="accordion-item">
                            <h2 class="accordion-header">
                                <button class="accordion-button @(c == 0 ? "" : "collapsed")" type="button"
                                        data-bs-toggle="collapse" data-bs-target="#@collapseId"
                                        aria-expanded="@expandedCat" aria-controls="@collapseId">
                                    <span class="me-2"><i class="bi bi-folder2-open"></i></span>
                                    <strong>@cat.CategoryName</strong>
                                    <span class="text-muted ms-2">@totalUnitsInCat unit(s)</span>
                                </button>
                            </h2>
                            <div id="@collapseId" class="accordion-collapse collapse @showCat"
                                 data-bs-parent="#categoryAccordion">
                                <div class="accordion-body">
                                    @foreach (var eq in cat.Equipment)
                                    {
                                        <div class="mb-3" data-equipment-group data-equipment-id="@eq.EquipmentID" data-daily-rate="@eq.Items.First().DailyRate">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <div>
                                                    <strong>@eq.EquipmentName</strong>
                                                    <small class="text-muted ms-2">@eq.Items.Count unit(s)</small>
                                                </div>
                                                <div class="form-check">
                                                    <input type="checkbox" class="form-check-input select-all"
                                                           id="select-all-@eq.EquipmentID"
                                                           data-equipment-id="@eq.EquipmentID" />
                                                    <label class="form-check-label small" for="select-all-@eq.EquipmentID">Select all</label>
                                                </div>
                                            </div>
                                            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-2">
                                                @foreach (var item in eq.Items)
                                                {
                                                    <div class="col">
                                                        <div class="form-check unit-tile p-2 border rounded h-100">
                                                            <input type="checkbox"
                                                                   class="form-check-input unit-checkbox"
                                                                   name="Form.EquipmentItemIDs"
                                                                   value="@item.ItemID"
                                                                   id="unit-@item.ItemID"
                                                                   data-equipment-id="@eq.EquipmentID"
                                                                   data-equipment-name="@eq.EquipmentName"
                                                                   data-daily-rate="@item.DailyRate" />
                                                            <label class="form-check-label small w-100" for="unit-@item.ItemID">
                                                                <code>@item.SerialNumber</code>
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <span asp-validation-for="Form.EquipmentItemIDs" class="text-danger small d-block mt-2"></span>
            }
        </div>

        <div class="col-lg-4">
            <div class="card sticky-top" style="top: 1rem;">
                <div class="card-body">
                    <h5 class="card-title"><i class="bi bi-clipboard-check"></i> Selection summary</h5>

                    <div class="d-flex justify-content-between align-items-baseline mb-2">
                        <span class="text-muted">Units selected</span>
                        <span class="h4 mb-0" id="summaryCount">0</span>
                    </div>

                    <hr class="my-2" />

                    <div class="mb-2">
                        <div class="text-muted small mb-1">Target equipment</div>
                        <ul class="list-unstyled small mb-0" id="summaryEquipment">
                            <li class="text-muted">No units selected yet.</li>
                        </ul>
                    </div>

                    <hr class="my-2" />

                    <div class="mb-2">
                        <label asp-for="Form.Reason" class="form-label small"></label>
                        <input asp-for="Form.Reason" class="form-control form-control-sm" />
                        <span asp-validation-for="Form.Reason" class="text-danger small"></span>
                    </div>

                    <div class="row g-2 mb-2">
                        <div class="col-6">
                            <label asp-for="Form.ExpectedEnd" class="form-label small"></label>
                            <input asp-for="Form.ExpectedEnd" type="date" class="form-control form-control-sm" />
                        </div>
                        <div class="col-6">
                            <label asp-for="Form.Cost" class="form-label small"></label>
                            <input asp-for="Form.Cost" type="number" step="0.01" min="0"
                                   class="form-control form-control-sm" id="costPerUnit" />
                        </div>
                    </div>

                    <div class="mb-2">
                        <label asp-for="Form.Notes" class="form-label small"></label>
                        <textarea asp-for="Form.Notes" class="form-control form-control-sm" rows="2"></textarea>
                    </div>

                    <hr class="my-2" />

                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Cost per unit</span>
                        <span class="small" id="costPerUnitLabel">₱0.00</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-muted small">Units</span>
                        <span class="small" id="unitsLabel">0</span>
                    </div>
                    <div class="d-flex justify-content-between fw-bold">
                        <span>Estimated total</span>
                        <span id="totalCost">₱0.00</span>
                    </div>

                    <div class="d-grid gap-2 mt-3">
                        <button type="submit" class="btn btn-primary" id="submitBtn" disabled>
                            <i class="bi bi-check-circle"></i> Open record(s)
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                            <i class="bi bi-arrow-left"></i> Cancel
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</form>

<style>
    .unit-tile { background: #fff; cursor: pointer; transition: background .12s ease, border-color .12s ease; }
    .unit-tile:hover { background: #f8f9fa; }
    .unit-tile input:checked + label { color: #0d6efd; font-weight: 600; }
    .unit-tile:has(input:checked) { border-color: #0d6efd; background: #eef5ff; }
    .select-all:checked + label { color: #0d6efd; font-weight: 600; }
</style>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (function () {
            const form = document.getElementById('maintenanceOpenForm');
            if (!form) return;

            const checkboxes = () => form.querySelectorAll('.unit-checkbox');
            const selectAlls = () => form.querySelectorAll('.select-all');
            const submitBtn = document.getElementById('submitBtn');
            const costInput = document.getElementById('costPerUnit');
            const summaryCount = document.getElementById('summaryCount');
            const summaryEquipment = document.getElementById('summaryEquipment');
            const costPerUnitLabel = document.getElementById('costPerUnitLabel');
            const unitsLabel = document.getElementById('unitsLabel');
            const totalCostEl = document.getElementById('totalCost');

            const money = (n) => '₱' + (Number(n) || 0).toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 });

            function updateSelectAllState(equipmentId) {
                const all = form.querySelectorAll(`.unit-checkbox[data-equipment-id="${equipmentId}"]`);
                const checked = form.querySelectorAll(`.unit-checkbox[data-equipment-id="${equipmentId}"]:checked`);
                const sa = form.getElementById ? form.getElementById(`select-all-${equipmentId}`) : document.getElementById(`select-all-${equipmentId}`);
                if (!sa) return;
                sa.checked = all.length > 0 && checked.length === all.length;
                sa.indeterminate = checked.length > 0 && checked.length < all.length;
            }

            function recalc() {
                const units = Array.from(checkboxes()).filter(c => c.checked);
                const count = units.length;

                // Cost breakdown by equipment
                const byEq = new Map();
                for (const cb of units) {
                    const eqName = cb.dataset.equipmentName;
                    if (!byEq.has(eqName)) byEq.set(eqName, { count: 0, rate: Number(cb.dataset.dailyRate) || 0 });
                    byEq.get(eqName).count += 1;
                }
                const costPerUnit = Number(costInput.value) || 0;

                summaryCount.textContent = count;
                unitsLabel.textContent = count;
                costPerUnitLabel.textContent = money(costPerUnit);
                totalCostEl.textContent = money(costPerUnit * count);

                if (byEq.size === 0) {
                    summaryEquipment.innerHTML = '<li class="text-muted">No units selected yet.</li>';
                } else {
                    const items = [];
                    for (const [name, info] of byEq) {
                        items.push(`<li><i class="bi bi-check2-square"></i> <strong>${name}</strong> × ${info.count}</li>`);
                    }
                    summaryEquipment.innerHTML = items.join('');
                }

                submitBtn.disabled = count === 0;
                submitBtn.textContent = count > 1
                    ? `Open ${count} record(s)`
                    : 'Open record';

                // Sync per-equipment select-all checkboxes
                const eqIds = new Set(Array.from(checkboxes()).map(c => Number(c.dataset.equipmentId)));
                eqIds.forEach(id => updateSelectAllState(id));
            }

            // Per-unit toggle
            form.addEventListener('change', (e) => {
                if (e.target.classList.contains('unit-checkbox')) {
                    updateSelectAllState(e.target.dataset.equipmentId);
                    recalc();
                } else if (e.target.classList.contains('select-all')) {
                    const eqId = e.target.dataset.equipmentId;
                    const subs = form.querySelectorAll(`.unit-checkbox[data-equipment-id="${eqId}"]`);
                    subs.forEach(s => { s.checked = e.target.checked; });
                    recalc();
                } else if (e.target === costInput) {
                    recalc();
                }
            });

            recalc();
        })();
    </script>
}
