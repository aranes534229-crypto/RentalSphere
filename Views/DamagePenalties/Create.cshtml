@model RentalSphere.Modules.DamagePenalty.DTOs.DamagePenaltyCreateDto
@{
    ViewData["Title"] = "Record Damage / Penalty";
    var types = ViewBag.PenaltyTypes as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>
                ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Record Damage / Penalty</h1>
    <a asp-action="Index" class="btn btn-outline-secondary">← Back</a>
</div>

@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="card">
    <div class="card-body">
        <form method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="RentalTransactionID" class="form-label"></label>
                    <input asp-for="RentalTransactionID" type="number" min="1" class="form-control" required />
                </div>
                <div class="col-md-4">
                    <label asp-for="PenaltyType" class="form-label"></label>
                    <select asp-for="PenaltyType" class="form-select"
                            asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(types, "Value", "Text"))"></select>
                </div>
                <div class="col-md-4">
                    <label asp-for="Amount" class="form-label"></label>
                    <input asp-for="Amount" type="number" step="0.01" min="0" class="form-control" required />
                </div>
                <div class="col-md-6">
                    <label asp-for="EquipmentID" class="form-label"></label>
                    <input asp-for="EquipmentID" type="number" class="form-control" />
                </div>
                <div class="col-md-6">
                    <label asp-for="EquipmentItemID" class="form-label"></label>
                    <input asp-for="EquipmentItemID" type="number" class="form-control" />
                </div>
                <div class="col-12">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="2" maxlength="500" required></textarea>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="2" maxlength="2000"></textarea>
                </div>
            </div>

            <div class="mt-3 d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-outline-secondary me-2">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </form>
    </div>
</div>
