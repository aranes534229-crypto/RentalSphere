@model RentalSphere.Modules.DamagePenalty.DTOs.DamagePenaltyDetailsDto
@{
    ViewData["Title"] = $"Damage #{Model.DamagePenaltyID}";
    var isAdmin = User.IsInRole(RentalSphere.Common.Constants.RoleNames.Admin);
    var badgeClass = Model.StatusName switch
    {
        "Pending" => "bg-warning text-dark",
        "AppliedToInvoice" => "bg-info text-dark",
        "Waived" => "bg-success",
        _ => "bg-secondary",
    };
}
<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Damage / Penalty #@Model.DamagePenaltyID</h1>
        <div class="text-muted">Rental transaction <a asp-controller="RentalTransactions" asp-action="Details" asp-route-id="@Model.RentalTransactionID">#@Model.RentalTransactionID</a></div>
    </div>
    <span class="badge @badgeClass fs-6">@Model.StatusName</span>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success">@ok</div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger">@err</div> }

<div class="row g-3">
    <div class="col-lg-7">
        <div class="card mb-3">
            <div class="card-header">Details</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-3">Type</dt><dd class="col-sm-9"><span class="badge bg-light text-dark">@Model.PenaltyTypeName</span></dd>
                    <dt class="col-sm-3">Equipment</dt><dd class="col-sm-9">@(Model.EquipmentName ?? "—") @(string.IsNullOrEmpty(Model.SerialNumber) ? "" : $"({Model.SerialNumber})")</dd>
                    <dt class="col-sm-3">Description</dt><dd class="col-sm-9">@Model.Description</dd>
                    <dt class="col-sm-3">Amount</dt><dd class="col-sm-9">₱@Model.Amount.ToString("N2")</dd>
                    <dt class="col-sm-3">Waived</dt><dd class="col-sm-9 text-success">₱@Model.WaivedAmount.ToString("N2")</dd>
                    <dt class="col-sm-3">Reported</dt><dd class="col-sm-9">@Model.ReportedAt.ToString("yyyy-MM-dd HH:mm") by @(Model.ReportedByUserName ?? "—")</dd>
                    @if (Model.ResolvedAt.HasValue)
                    {
                        <dt class="col-sm-3">Resolved</dt>
                        <dd class="col-sm-9">@Model.ResolvedAt.Value.ToString("yyyy-MM-dd HH:mm") by @(Model.ResolvedByUserName ?? "—")</dd>
                    }
                    @if (!string.IsNullOrEmpty(Model.Notes))
                    {
                        <dt class="col-sm-3">Notes</dt><dd class="col-sm-9">@Model.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-3">
            <div class="card-header">Update Amount</div>
            <div class="card-body">
                <form method="post" asp-action="UpdateAmount" asp-route-id="@Model.DamagePenaltyID">
                    @Html.AntiForgeryToken()
                    <div class="input-group">
                        <span class="input-group-text">₱</span>
                        <input type="number" name="amount" step="0.01" min="0"
                               value="@Model.Amount" class="form-control" />
                        <button class="btn btn-primary"
                                onclick="return confirm('Update amount and resync the linked invoice line?')">
                            Save
                        </button>
                    </div>
                    <div class="form-text">Saving also pushes the amount to the linked invoice line (if any) and recomputes totals.</div>
                </form>
            </div>
        </div>

        @if (isAdmin && Model.WaivedAmount < Model.Amount && Model.StatusName != "Waived")
        {
            <div class="card border-warning">
                <div class="card-header bg-warning-subtle">Admin: Waive</div>
                <div class="card-body">
                    <form method="post" asp-action="Waive" asp-route-id="@Model.DamagePenaltyID">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Waive amount (max ₱@(Model.Amount - Model.WaivedAmount).ToString("N2"))</label>
                        <input type="number" name="amount" step="0.01" min="0.01"
                               max="@(Model.Amount - Model.WaivedAmount)" class="form-control mb-2" required />
                        <input type="text" name="reason" class="form-control mb-2" placeholder="Reason" maxlength="500" />
                        <button class="btn btn-warning w-100"
                                onclick="return confirm('Waive this amount?')">
                            Waive
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">← Back to list</a>
</div>
