@using Microsoft.AspNetCore.Identity
@inject SignInManager<RentalSphere.Identity.ApplicationUser> SignInManager
@inject UserManager<RentalSphere.Identity.ApplicationUser> UserManager
@model RentalSphere.Modules.ReservationManagement.ViewModels.MyReservationsViewModel
@{
    ViewData["Title"] = "My reservations";
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var firstName = user?.FirstName ?? "there";
    var today = DateTime.UtcNow.Date;

    // "Upcoming" = rental end is in the future AND not cancelled/completed.
    // "Past" = rental end is in the past OR status is Completed.
    int upcoming = 0, past = 0;
    foreach (var r in Model.Items)
    {
        var isClosed = r.Status == "Cancelled" || r.Status == "Completed" || r.Status == "Expired";
        if (!isClosed && r.RentalEndDate.Date >= today) upcoming++;
        else past++;
    }
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-calendar-event"></i> My reservations</h2>
        <small class="text-muted">Hello, @firstName. Track your past and upcoming rentals here.</small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New reservation
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@if (!Model.Items.Any())
{
    <div class="card">
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
            <p class="mb-1 mt-2">You haven't made a reservation yet.</p>
            <p class="text-muted small">Browse the catalog and reserve equipment for your next event.</p>
            <div class="mt-3">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Make your first reservation
                </a>
                <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-box-seam"></i> Equipment catalog
                </a>
            </div>
        </div>
    </div>
}
else
{
    <ul class="nav nav-pills mb-3 gap-1" id="whenFilter">
        <li class="nav-item">
            <a class="nav-link active text-white bg-secondary" data-filter="all" href="#">All <span class="badge bg-light text-dark ms-1">@(upcoming + past)</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" data-filter="upcoming" href="#" style="background-color: #f1f3f5;">Upcoming <span class="badge bg-primary ms-1">@upcoming</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" data-filter="past" href="#" style="background-color: #f1f3f5;">Past <span class="badge bg-secondary ms-1">@past</span></a>
        </li>
    </ul>

    <form method="get" class="d-none">
        <input type="hidden" name="pageSize" value="@Model.PageSize" />
    </form>

    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Rental dates</th>
                        <th>Items</th>
                        <th class="text-end">Estimated</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.Items)
                    {
                        var isClosed = r.Status == "Cancelled" || r.Status == "Completed" || r.Status == "Expired";
                        var bucket = (!isClosed && r.RentalEndDate.Date >= today) ? "upcoming" : "past";
                        var days = Math.Max(1, (r.RentalEndDate.Date - r.RentalStartDate.Date).Days);
                        <tr data-bucket="@bucket">
                            <td><a asp-action="Details" asp-route-id="@r.ReservationID">#@r.ReservationID</a></td>
                            <td>
                                <small>@r.RentalStartDate.ToString("yyyy-MM-dd") &rarr; @r.RentalEndDate.ToString("yyyy-MM-dd")</small>
                                <small class="text-muted ms-1">(@days day@(days == 1 ? "" : "s"))</small>
                            </td>
                            <td>@r.ItemCount</td>
                            <td class="text-end">&#8369;@r.TotalEstimatedCost.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReservationID" class="btn btn-sm btn-outline-primary" title="Open"><i class="bi bi-box-arrow-up-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @* ponytail: JS shim filters the current page slice only. Switching pages resets to All because the pill click is view-side and the page navigation is server-side. Replace with a real ?when= param when this list grows. *@
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}

@section Scripts {
    <script>
        (function () {
            var pills = document.querySelectorAll('#whenFilter a[data-filter]');
            var rows = document.querySelectorAll('tbody tr[data-bucket]');
            pills.forEach(function (pill) {
                pill.addEventListener('click', function (e) {
                    e.preventDefault();
                    var f = this.getAttribute('data-filter');
                    pills.forEach(function (p) {
                        p.classList.remove('active', 'text-white', 'bg-secondary');
                        p.classList.add('text-dark');
                        p.style.backgroundColor = '#f1f3f5';
                    });
                    this.classList.add('active', 'text-white', 'bg-secondary');
                    this.classList.remove('text-dark');
                    this.style.backgroundColor = '';
                    rows.forEach(function (r) {
                        r.style.display = (f === 'all' || r.getAttribute('data-bucket') === f) ? '' : 'none';
                    });
                });
            });
        })();
    </script>
}
