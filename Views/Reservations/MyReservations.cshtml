@using Microsoft.AspNetCore.Identity
@inject SignInManager<RentalSphere.Identity.ApplicationUser> SignInManager
@inject UserManager<RentalSphere.Identity.ApplicationUser> UserManager
@model RentalSphere.Modules.ReservationManagement.ViewModels.MyReservationsViewModel
@{
    ViewData["Title"] = "My reservations";
    var user = SignInManager.IsSignedIn(User) ? await UserManager.GetUserAsync(User) : null;
    var firstName = user?.FirstName ?? "there";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-calendar-event"></i> My reservations</h2>
        <small class="text-muted">
            Hello, @firstName. Track your past and upcoming rentals here.
        </small>
    </div>
    <a asp-action="Create" class="btn reservation-add-btn">
        <i class="bi bi-plus-circle"></i> New reservation
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@if (!Model.Items.Any() && string.IsNullOrWhiteSpace(Model.StatusFilter))
{
    <div class="card">
        <div class="text-center text-muted py-5">
            <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
            <p class="mb-1 mt-2">You haven't made a reservation yet.</p>
            <p class="text-muted small">Browse the catalog and reserve equipment for your next event.</p>
            <div class="mt-3">
                <a asp-action="Create" class="btn btn-primary">
                    <i class="bi bi-plus-circle"></i> Make your first reservation
                </a>
                <a asp-controller="Equipment" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-box-seam"></i> Equipment catalog
                </a>
            </div>
        </div>
    </div>
}
else
{
    var allActive = string.IsNullOrWhiteSpace(Model.StatusFilter);
    var isPending = Model.StatusFilter == "Pending";
    var isConfirmed = Model.StatusFilter == "Confirmed";
    var isOther = Model.StatusFilter == "Other"
        || (!allActive && !isPending && !isConfirmed && Model.StatusFilter != "Other");

    <ul class="nav nav-pills mb-3 gap-1">
        <li class="nav-item">
            <a class="nav-link @(allActive ? "active text-white bg-secondary" : "text-dark")"
               href="@Url.Action("MyReservations", new { statusFilter = "", page = 1, pageSize = Model.PageSize })"
               style="@(allActive ? "" : "background-color: #f1f3f5;")")">All <span class="badge bg-light text-dark ms-1">@Model.TotalCount</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(isPending ? "active text-white bg-secondary" : "text-dark")"
               href="@Url.Action("MyReservations", new { statusFilter = "Pending", page = 1, pageSize = Model.PageSize })"
               style="@(isPending ? "" : "background-color: #f1f3f5;")")">Pending <span class="badge bg-primary ms-1">@Model.PendingCount</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(isConfirmed ? "active text-white bg-secondary" : "text-dark")"
               href="@Url.Action("MyReservations", new { statusFilter = "Confirmed", page = 1, pageSize = Model.PageSize })"
               style="@(isConfirmed ? "" : "background-color: #f1f3f5;")")">Confirmed <span class="badge bg-warning text-dark ms-1">@Model.ConfirmedCount</span></a>
        </li>
        <li class="nav-item">
            <a class="nav-link @(isOther ? "active text-white bg-secondary" : "text-dark")"
               href="@Url.Action("MyReservations", new { statusFilter = "Other", page = 1, pageSize = Model.PageSize })"
               style="@(isOther ? "" : "background-color: #f1f3f5;")")">Other <span class="badge bg-secondary ms-1">@Model.OtherCount</span></a>
        </li>
    </ul>

    <div class="reservation-main-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle reservation-table mb-0">
                <thead class="reservation-table-header">
                    <tr>
                        <th>#</th>
                        <th>Rental dates</th>
                        <th>Items</th>
                        <th class="text-end">Estimated</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="6" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No reservations match this filter.</p>
                                <a asp-action="MyReservations" asp-route-pageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Show all
                                </a>
                            </div>
                        </td></tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        var days = Math.Max(1, (r.RentalEndDate.Date - r.RentalStartDate.Date).Days);
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@r.ReservationID" class="reservation-name-link">#@r.ReservationID</a></td>
                            <td><small>@r.RentalStartDate.ToString("yyyy-MM-dd") &rarr; @r.RentalEndDate.ToString("yyyy-MM-dd")</small> <small class="text-muted ms-1">(@days day@(days == 1 ? "" : "s"))</small></td>
                            <td>@r.ItemCount</td>
                            <td class="text-end">&#8369;@r.TotalEstimatedCost.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReservationID" class="btn btn-sm btn-outline-primary" title="Open"><i class="bi bi-box-arrow-up-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <label for="reservationPageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                    <select id="reservationPageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('reservationPageSize').value = this.value; document.getElementById('reservationFilterForm').submit();">
                        @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                        @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                        @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                        @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                    </select>
                </div>
                <nav>
                    <div class="d-flex align-items-center reservation-pagination" style="gap: 6px;">
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.Page)
                            {
                                <a class="pagination-pill active" href="#">@p</a>
                            }
                            else
                            {
                                <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                            }
                        }
                        <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                    </div>
                </nav>
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="card-footer text-muted small">
                Showing @Model.TotalCount reservation@(Model.TotalCount == 1 ? "" : "s")
            </div>
        }
    </div>
}

@* Preserve the hidden pageSize input the Show: dropdown reads, scoped to this view. *@
<form method="get" class="d-none" id="reservationFilterForm">
    <input type="hidden" name="statusFilter" value="@Model.StatusFilter" />
    <input type="hidden" name="pageSize" id="reservationPageSize" value="@Model.PageSize" />
</form>

@section Scripts {
    <script>
        // Wire the Show: dropdown to the hidden pageSize form above so the
        // current statusFilter is preserved on submit.
        (function () {
            var sel = document.getElementById('reservationPageSizeSelect');
            if (sel) {
                sel.addEventListener('change', function () {
                    document.getElementById('reservationPageSize').value = this.value;
                    document.getElementById('reservationFilterForm').submit();
                });
            }
        })();
    </script>
}
