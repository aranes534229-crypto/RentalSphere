@model RentalSphere.Modules.ReservationManagement.ViewModels.ReservationCreateViewModel
@{
    ViewData["Title"] = "New reservation";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var showCustomerDropdown = !isCustomer;
    var backAction = isCustomer ? "MyReservations" : "Index";
    var equipmentJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Equipment.Select(e => new { id = e.EquipmentID, name = e.Name, rate = e.DailyRate }));
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="@backAction">Reservations</a></li>
        <li class="breadcrumb-item active">Create</li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">
        <h3 class="card-title mb-3"><i class="bi bi-calendar-plus"></i> New reservation</h3>

        <div class="alert alert-info d-flex align-items-start" role="alert">
            <i class="bi bi-info-circle me-2 mt-1"></i>
            <div>
                Reservations are not charged. The estimated total is computed from
                equipment daily rates &times; rental days. A reservation becomes a
                rental when staff checks it out.
            </div>
        </div>

        <form asp-action="Create" method="post" id="reservationForm">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            @if (showCustomerDropdown)
            {
                <div class="mb-3">
                    <label asp-for="Form.CustomerID" class="form-label"></label>
                    <select asp-for="Form.CustomerID" class="form-select" asp-items="@(new SelectList(Model.Customers, "CustomerID", "DisplayName"))">
                        <option value="">-- select customer --</option>
                    </select>
                    <span asp-validation-for="Form.CustomerID" class="text-danger"></span>
                </div>
            }
            else
            {
                <div class="alert alert-info">You are creating a reservation for yourself.</div>
                <input type="hidden" asp-for="Form.CustomerID" value="0" />
            }

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.RentalStartDate" class="form-label"></label>
                    <input asp-for="Form.RentalStartDate" class="form-control" type="date" id="startDate" />
                    <span asp-validation-for="Form.RentalStartDate" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.RentalEndDate" class="form-label"></label>
                    <input asp-for="Form.RentalEndDate" class="form-control" type="date" id="endDate" />
                    <span asp-validation-for="Form.RentalEndDate" class="text-danger"></span>
                </div>
            </div>

            <h5 class="mt-3">Equipment units</h5>
            <p class="text-muted small">Add at least one line item. Quantity is how many units of that equipment.</p>

            <input type="hidden" id="equipment-data" value="@equipmentJson" />

            <table class="table table-sm align-middle" id="items-table">
                <thead class="table-light">
                    <tr>
                        <th>Equipment</th>
                        <th style="width: 8rem;">Quantity</th>
                        <th style="width: 4rem;"></th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Form.Items == null || !Model.Form.Items.Any())
                    {
                        <tr class="item-row">
                            <td>
                                <select name="Form.Items[0].EquipmentID" class="form-select item-equipment">
                                    <option value="">-- pick equipment --</option>
                                    @foreach (var e in Model.Equipment)
                                    {
                                        <option value="@e.EquipmentID">@e.Name (₱@e.DailyRate.ToString("N2")/day)</option>
                                    }
                                </select>
                            </td>
                            <td><input type="number" name="Form.Items[0].Quantity" class="form-control item-qty" min="1" value="1" /></td>
                            <td></td>
                        </tr>
                    }
                    else
                    {
                        @for (var idx = 0; idx < Model.Form.Items.Count; idx++)
                        {
                            var i = Model.Form.Items[idx];
                            <tr class="item-row">
                                <td>
                                    <select name="Form.Items[@idx].EquipmentID" class="form-select item-equipment">
                                        <option value="">-- pick equipment --</option>
                                        @foreach (var e in Model.Equipment)
                                        {
                                            if (e.EquipmentID == i.EquipmentID)
                                            {
                                                <option value="@e.EquipmentID" selected="selected">@e.Name (₱@e.DailyRate.ToString("N2")/day)</option>
                                            }
                                            else
                                            {
                                                <option value="@e.EquipmentID">@e.Name (₱@e.DailyRate.ToString("N2")/day)</option>
                                            }
                                        }
                                    </select>
                                </td>
                                <td><input type="number" name="Form.Items[@idx].Quantity" class="form-control item-qty" min="1" value="@i.Quantity" /></td>
                                <td></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>

            <button type="button" id="add-row" class="btn btn-sm btn-outline-secondary"><i class="bi bi-plus"></i> Add another item</button>

            <div class="mt-3 mb-3">
                <label asp-for="Form.Notes" class="form-label"></label>
                <textarea asp-for="Form.Notes" class="form-control" rows="3" placeholder="Optional. Delivery address, special requests, etc."></textarea>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="@backAction" class="btn btn-outline-secondary">Cancel</a>
                <div class="d-flex align-items-center gap-3">
                    <div class="text-end">
                        <small class="text-muted">Estimated total</small>
                        <div class="fs-4 fw-semibold text-success" id="runningTotal">&#8369;0.00</div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Create reservation</button>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            var equipmentData = document.getElementById('equipment-data').value;
            var equipment = JSON.parse(equipmentData);
            var rowIndex = document.querySelectorAll('#items-table .item-row').length;

            function buildOptions() {
                var s = '<option value="">-- pick equipment --</option>';
                for (var i = 0; i < equipment.length; i++) {
                    s += '<option value="' + equipment[i].id + '">' + equipment[i].name + ' (₱' + equipment[i].rate.toFixed(2) + '/day)</option>';
                }
                return s;
            }

            function getDays() {
                var s = document.getElementById('startDate').value;
                var e = document.getElementById('endDate').value;
                if (!s || !e) return 1;
                var ds = new Date(s);
                var de = new Date(e);
                if (isNaN(ds) || isNaN(de) || de <= ds) return 1;
                return Math.round((de - ds) / (1000 * 60 * 60 * 24));
            }

            function getRate(equipmentId) {
                for (var i = 0; i < equipment.length; i++) {
                    if (equipment[i].id == equipmentId) return equipment[i].rate;
                }
                return 0;
            }

            function recomputeTotal() {
                var days = getDays();
                var total = 0;
                var rows = document.querySelectorAll('#items-table .item-row');
                for (var i = 0; i < rows.length; i++) {
                    var sel = rows[i].querySelector('.item-equipment');
                    var qty = rows[i].querySelector('.item-qty');
                    if (!sel || !qty) continue;
                    var rate = getRate(sel.value);
                    var q = parseInt(qty.value, 10);
                    if (isNaN(q) || q < 1) q = 0;
                    total += rate * q * days;
                }
                document.getElementById('runningTotal').innerHTML = '₱' + total.toLocaleString('en-PH', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            document.getElementById('add-row').addEventListener('click', function () {
                var tbody = document.querySelector('#items-table tbody');
                var tr = document.createElement('tr');
                tr.className = 'item-row';
                tr.innerHTML =
                    '<td><select name="Form.Items[' + rowIndex + '].EquipmentID" class="form-select item-equipment">' + buildOptions() + '</select></td>' +
                    '<td><input type="number" name="Form.Items[' + rowIndex + '].Quantity" class="form-control item-qty" min="1" value="1" /></td>' +
                    '<td><button type="button" class="btn btn-sm btn-outline-danger remove-row"><i class="bi bi-x"></i></button></td>';
                tbody.appendChild(tr);
                rowIndex++;
                recomputeTotal();
            });

            document.addEventListener('click', function (e) {
                if (e.target && e.target.closest && e.target.closest('.remove-row')) {
                    e.target.closest('tr').remove();
                    recomputeTotal();
                }
            });
            document.addEventListener('input', function (e) {
                if (e.target && (e.target.classList.contains('item-equipment') || e.target.classList.contains('item-qty'))) {
                    recomputeTotal();
                }
            });
            document.addEventListener('change', function (e) {
                if (e.target && e.target.id && (e.target.id === 'startDate' || e.target.id === 'endDate')) {
                    recomputeTotal();
                }
            });

            recomputeTotal();
        })();
    </script>
}
