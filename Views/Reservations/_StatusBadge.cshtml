@model string
@{
    // Reservation status -> text color. No badge — plain inline text.
    // Green = positive/active states, red = negative/ended states.
    var cls = Model switch
    {
        "Confirmed"  => "text-success",
        "CheckedOut" => "text-info",
        "Completed"  => "text-success",
        "Pending"    => "text-warning",
        "Cancelled"  => "text-danger",
        "Expired"    => "text-muted",
        _            => "text-muted"
    };
}
<span class="@cls">@Model</span>
