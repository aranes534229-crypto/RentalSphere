@model RentalSphere.Modules.ReservationManagement.ViewModels.ReservationIndexViewModel
@{
    ViewData["Title"] = "Reservations";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var canWrite = isAdmin || isStaff;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-calendar-check"></i> Reservations</h2>
        <small class="text-muted">
            @(isCustomer
                ? "Your reservations."
                : "All customer reservations.")
        </small>
    </div>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle"></i> New reservation
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by customer name..." />
        </div>
        <div class="col-md-4">
            <select name="statusFilter" class="form-select" asp-items="@(new SelectList(Model.Statuses, "Value", "Text", Model.StatusFilter))">
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

@if (isCustomer)
{
    @* ponytail: card grid is customer-only. Staff keep the table for ops. *@
    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">You have no reservations yet.</p>
                <a asp-action="Create" class="btn btn-primary mt-2">
                    <i class="bi bi-plus-circle"></i> Make a reservation
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Items)
            {
                var days = Math.Max(1, (r.RentalEndDate.Date - r.RentalStartDate.Date).Days);
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">Reservation #@r.ReservationID</h5>
                                <partial name="_StatusBadge" model="r.Status" />
                            </div>
                            <p class="mb-2">
                                <i class="bi bi-calendar-event text-muted"></i>
                                <strong>@r.RentalStartDate.ToString("MMM d")</strong> →
                                <strong>@r.RentalEndDate.ToString("MMM d, yyyy")</strong>
                                <small class="text-muted">(@days day@(days == 1 ? "" : "s"))</small>
                            </p>
                            <p class="mb-2"><small class="text-muted">@r.ItemCount item@(r.ItemCount == 1 ? "" : "s")</small></p>
                            <p class="text-success fw-semibold mb-3">
                                &#8369;@r.TotalEstimatedCost.ToString("N2")
                                <small class="text-muted fw-normal">estimated</small>
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@r.ReservationID" class="btn btn-sm btn-outline-primary w-100">
                                    View details <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("id")">#@(Model.Sort == "id" ? " ▲" : Model.Sort == "id_desc" ? " ▼" : "")</a>
                        </th>
                        <th>
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("customer")">Customer@(Model.Sort == "customer" ? " ▲" : Model.Sort == "customer_desc" ? " ▼" : "")</a>
                        </th>
                        <th>
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("dates")">Rental dates@(Model.Sort == "dates" ? " ▲" : Model.Sort == "dates_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Items</th>
                        <th class="text-end">
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("total")">Estimated@(Model.Sort == "total" ? " ▲" : Model.Sort == "total_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No reservations match your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@r.ReservationID">#@r.ReservationID</a></td>
                            <td>
                                @if (canWrite)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerID">@r.CustomerName</a>
                                }
                                else
                                {
                                    @r.CustomerName
                                }
                            </td>
                            <td><small>@r.RentalStartDate.ToString("yyyy-MM-dd") &rarr; @r.RentalEndDate.ToString("yyyy-MM-dd")</small></td>
                            <td>@r.ItemCount</td>
                            <td class="text-end">&#8369;@r.TotalEstimatedCost.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@r.ReservationID" class="btn btn-sm btn-outline-primary" title="Open"><i class="bi bi-box-arrow-up-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                            </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
