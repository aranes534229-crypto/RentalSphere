@model RentalSphere.Modules.ReservationManagement.ViewModels.ReservationIndexViewModel
@{
    ViewData["Title"] = "Reservations";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var canWrite = isAdmin || isStaff;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-calendar-check"></i> Reservations</h2>
        <small class="text-muted d-block mt-1">
            @(isCustomer
                ? "Browse and manage your own reservations."
                : "All customer reservations.")
        </small>
    </div>
    @if (canWrite)
    {
        <a asp-action="Create" class="btn reservation-add-btn">
            <i class="bi bi-plus-circle"></i> New reservation
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 reservation-filter-form" id="reservationFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.Search" class="form-control reservation-filter-control" id="reservationSearchInput" placeholder="Search by customer name..." autocomplete="off" />
        </div>
        <div class="col-md-3">
            <select name="statusFilter" class="form-select reservation-filter-control" id="reservationStatusSelect" asp-items="@(new SelectList(Model.Statuses, "Value", "Text", Model.StatusFilter))" onchange="this.form.submit();"></select>
        </div>
        <div class="col-md-2 d-flex align-items-center">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="reservationPageSize" value="@Model.PageSize" />
</form>

@if (isCustomer)
{
    @* Customer self-service: card grid, mirrors the Equipment customer catalog layout. *@
    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">
                    @(hasFilter ? "No reservations match your filters." : "You have no reservations yet.")
                </p>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-x-lg"></i> Reset filters
                    </a>
                }
                else
                {
                    <a asp-action="Create" class="btn btn-primary mt-2">
                        <i class="bi bi-plus-circle"></i> Make a reservation
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var r in Model.Items)
            {
                var days = Math.Max(1, (r.RentalEndDate.Date - r.RentalStartDate.Date).Days);
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title mb-0">Reservation #@r.ReservationID</h5>
                                <partial name="_StatusBadge" model="r.Status" />
                            </div>
                            <p class="mb-2">
                                <i class="bi bi-calendar-event text-muted"></i>
                                <strong>@r.RentalStartDate.ToString("MMM d")</strong> &rarr;
                                <strong>@r.RentalEndDate.ToString("MMM d, yyyy")</strong>
                                <small class="text-muted">(@days day@(days == 1 ? "" : "s"))</small>
                            </p>
                            <p class="mb-2"><small class="text-muted">@r.ItemCount item@(r.ItemCount == 1 ? "" : "s")</small></p>
                            <p class="text-success fw-semibold mb-3">
                                &#8369;@r.TotalEstimatedCost.ToString("N2")
                                <small class="text-muted fw-normal">estimated</small>
                            </p>
                            <div class="mt-auto">
                                <a asp-action="Details" asp-route-id="@r.ReservationID" class="btn btn-sm btn-primary w-100">
                                    View details <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer mt-3 d-flex justify-content-between align-items-center bg-white border rounded">
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)&ndash;@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount
            </small>
            <nav>
                <div class="d-flex align-items-center reservation-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
}
else
{
    <div class="reservation-main-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle reservation-table">
                <thead class="reservation-table-header">
                    <tr>
                        <th>
                            <a class="reservation-header-link" href="@Model.SortUrl("id")">#@(Model.Sort == "id" ? " ▲" : Model.Sort == "id_desc" ? " ▼" : "")</a>
                        </th>
                        <th>
                            <a class="reservation-header-link" href="@Model.SortUrl("customer")">Customer@(Model.Sort == "customer" ? " ▲" : Model.Sort == "customer_desc" ? " ▼" : "")</a>
                        </th>
                        <th>
                            <a class="reservation-header-link" href="@Model.SortUrl("dates")">Rental dates@(Model.Sort == "dates" ? " ▲" : Model.Sort == "dates_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Items</th>
                        <th class="text-end">
                            <a class="reservation-header-link d-inline-block" href="@Model.SortUrl("total")">Estimated@(Model.Sort == "total" ? " ▲" : Model.Sort == "total_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Status</th>
                        @if (canWrite)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@(canWrite ? 7 : 6)" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-calendar-x" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No reservations match your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@r.ReservationID" class="reservation-name-link">#@r.ReservationID</a></td>
                            <td>
                                @if (canWrite)
                                {
                                    <a asp-controller="Customers" asp-action="Details" asp-route-id="@r.CustomerID" class="reservation-name-link">@r.CustomerName</a>
                                }
                                else
                                {
                                    @r.CustomerName
                                }
                            </td>
                            <td><small>@r.RentalStartDate.ToString("yyyy-MM-dd") &rarr; @r.RentalEndDate.ToString("yyyy-MM-dd")</small></td>
                            <td>@r.ItemCount</td>
                            <td class="text-end">&#8369;@r.TotalEstimatedCost.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="r.Status" /></td>
                            @if (canWrite)
                            {
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link p-0 reservation-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end reservation-popout">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@r.ReservationID"><i class="bi bi-eye me-2"></i>Open</a></li>
                                        </ul>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <label for="reservationPageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                    <select id="reservationPageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('reservationPageSize').value = this.value; document.getElementById('reservationFilterForm').submit();">
                        @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                        @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                        @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                        @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                    </select>
                </div>
                <nav>
                    <div class="d-flex align-items-center reservation-pagination" style="gap: 6px;">
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.Page)
                            {
                                <a class="pagination-pill active" href="#">@p</a>
                            }
                            else
                            {
                                <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                            }
                        }
                        <span class="pagination-ellipsis" aria-hidden="true">&hellip;</span>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                    </div>
                </nav>
            </div>
        }
    </div>
}