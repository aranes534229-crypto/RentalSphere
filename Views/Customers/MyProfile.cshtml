@model RentalSphere.Modules.CustomerManagement.DTOs.CustomerDetailsDto
@{
    ViewData["Title"] = "My Profile";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item active">My Profile</li>
    </ol>
</nav>

@if (TempData["Success"] is string s)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @s
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["Error"] is string e)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @e
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h3 class="card-title mb-0">@Model.FirstName @Model.LastName</h3>
                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Inactive</span>
                    }
                </div>
                <p class="text-muted mb-3">@Model.Email</p>

                <dl class="row mb-3">
                    <dt class="col-sm-3">Phone</dt>
                    <dd class="col-sm-9">@(Model.Phone ?? "—")</dd>
                    <dt class="col-sm-3">Address</dt>
                    <dd class="col-sm-9">@(string.Join(", ", new[] { Model.Address, Model.City, Model.PostalCode }.Where(s => !string.IsNullOrWhiteSpace(s))) ?? "—")</dd>
                    <dt class="col-sm-3">Loyalty tier</dt>
                    <dd class="col-sm-9">
                        <span class="badge bg-secondary">@Model.LoyaltyTier</span>
                    </dd>
                    <dt class="col-sm-3">Total reservations</dt>
                    <dd class="col-sm-9">@Model.ReservationCount</dd>
                    <dt class="col-sm-3">Registered</dt>
                    <dd class="col-sm-9">@Model.DateRegistered.ToString("yyyy-MM-dd HH:mm")</dd>
                </dl>

                @{
                    var reservations = ViewData["RecentReservations"] as List<RentalSphere.Modules.ReservationManagement.DTOs.ReservationListItemDto>
                        ?? new List<RentalSphere.Modules.ReservationManagement.DTOs.ReservationListItemDto>();
                }
                <h5 class="mt-4 mb-2"><i class="bi bi-calendar-event"></i> Recent reservations</h5>
                @if (!reservations.Any())
                {
                    <p class="text-muted small mb-0">No reservations yet. Browse our equipment to make your first booking.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Dates</th>
                                    <th>Items</th>
                                    <th class="text-end">Est. cost</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in reservations)
                                {
                                    <tr>
                                        <td>
                                            <div>@r.RentalStartDate.ToString("yyyy-MM-dd") → @r.RentalEndDate.ToString("yyyy-MM-dd")</div>
                                            <small class="text-muted">Booked @r.ReservationDate.ToString("yyyy-MM-dd")</small>
                                        </td>
                                        <td>@r.ItemCount item@(r.ItemCount == 1 ? "" : "s")</td>
                                        <td class="text-end">₱@r.TotalEstimatedCost.ToString("N2")</td>
                                        <td>
                                            @switch (r.Status)
                                            {
                                                case "Pending":
                                                    <span class="badge bg-warning text-dark">Pending</span>
                                                    break;
                                                case "Confirmed":
                                                    <span class="badge bg-primary">Confirmed</span>
                                                    break;
                                                case "Active":
                                                    <span class="badge bg-info text-dark">Active</span>
                                                    break;
                                                case "Completed":
                                                    <span class="badge bg-success">Completed</span>
                                                    break;
                                                case "Cancelled":
                                                    <span class="badge bg-secondary">Cancelled</span>
                                                    break;
                                                default:
                                                    <span class="badge bg-light text-dark">@r.Status</span>
                                                    break;
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (Model.ReservationCount > reservations.Count)
                    {
                        <p class="text-muted small mt-2 mb-0">
                            Showing @reservations.Count of @Model.ReservationCount reservations. Contact us for older records.
                        </p>
                    }
                }

                <div class="mt-3">
                    <a asp-action="MyProfileEdit" class="btn btn-primary">
                        <i class="bi bi-pencil"></i> Edit profile
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-header">
                <i class="bi bi-bell"></i> Activity
            </div>
            <div class="card-body">
                <p class="text-muted small mb-2">
                    View follow-ups our team has scheduled for you — e.g. a call to confirm your booking.
                </p>
                <a asp-controller="CustomerCrm" asp-action="MyFollowUps" class="btn btn-outline-info w-100">
                    <i class="bi bi-calendar-check"></i> View my follow-ups
                </a>
                <p class="text-muted small mt-3 mb-0">
                    <i class="bi bi-info-circle"></i>
                    Internal staff notes about your account are not shown here for your privacy.
                </p>
            </div>
        </div>
    </div>
</div>
