@model RentalSphere.Modules.CustomerManagement.ViewModels.CustomerIndexViewModel
@{
    ViewData["Title"] = "Customers";
    var canWrite = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Staff);
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.LoyaltyFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-people"></i> Customers</h2>
        <small class="text-muted d-block mt-1">Manage customer accounts and loyalty tiers.</small>
    </div>
    @if (canWrite)
    {
        <a asp-action="Create" class="btn equipment-add-btn">
            <i class="bi bi-plus-circle"></i> Add customer
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 equipment-filter-form" id="customersFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control equipment-filter-control" id="customersSearchInput" placeholder="Search by name or email..." autocomplete="off" />
        </div>
        <div class="col-md-3">
            <select name="loyaltyTier" class="form-select equipment-filter-control" id="customersLoyaltySelect" asp-items="@(new SelectList(Model.LoyaltyTiers, "Value", "Text", Model.LoyaltyFilter))">
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="customersPageSize" value="@Model.PageSize" />
</form>

<div class="equipment-main-card">
    <div class="table-responsive">
        <table class="table table-hover align-middle equipment-table">
            <thead class="equipment-table-header">
                <tr>
                    <th>
                        <a class="equipment-header-link" href="@Model.SortUrl("name")">Name@(Model.Sort == "name" ? " ▲" : Model.Sort == "name_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="equipment-header-link" href="@Model.SortUrl("email")">Email@(Model.Sort == "email" ? " ▲" : Model.Sort == "email_desc" ? " ▼" : "")</a>
                    </th>
                    <th>Phone</th>
                    <th>
                        <a class="equipment-header-link" href="@Model.SortUrl("tier")">Loyalty@(Model.Sort == "tier" ? " ▲" : Model.Sort == "tier_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="equipment-header-link" href="@Model.SortUrl("registered")">Registered@(Model.Sort == "registered" ? " ▲" : Model.Sort == "registered_desc" ? " ▼" : "")</a>
                    </th>
                    <th>Status</th>
                    @if (canWrite)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="@(canWrite ? 7 : 6)" class="p-0">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                            <p class="mb-1 mt-2">
                                @if (hasFilter)
                                {
                                    <text>No customers match your filters.</text>
                                }
                                else
                                {
                                    <text>No customers yet.</text>
                                }
                            </p>
                            @if (hasFilter)
                            {
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Reset filters
                                </a>
                            }
                        </div>
                    </td></tr>
                }
                @foreach (var c in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@c.CustomerID" class="equipment-name-link">@c.FirstName @c.LastName</a></td>
                        <td>@c.Email</td>
                        <td>@(c.Phone ?? "—")</td>
                        <td>@c.LoyaltyTier</td>
                        <td><small>@c.DateRegistered.ToString("yyyy-MM-dd")</small></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="text-success">Active</span>
                            }
                            else
                            {
                                <span class="text-danger">Inactive</span>
                            }
                        </td>
                        @if (canWrite)
                        {
                            <td class="text-end">
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-link p-0 equipment-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end equipment-popout">
                                        <li><a class="dropdown-item" asp-action="Details" asp-route-id="@c.CustomerID"><i class="bi bi-eye me-2"></i>View details</a></li>
                                        <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@c.CustomerID"><i class="bi bi-pencil me-2"></i>Edit customer</a></li>
                                    </ul>
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('customersPageSize').value = this.value; document.getElementById('customersFilterForm').submit();">
                    @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                    @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                    @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                    @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                </select>
            </div>
            <div class="d-flex align-items-center">
                <small class="text-muted me-3 mb-0">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount @(Model.TotalCount == 1 ? "customer" : "customers")
                </small>
                <nav>
                    <div class="d-flex align-items-center equipment-pagination" style="gap: 6px;">
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.Page)
                            {
                                <a class="pagination-pill active" href="#">@p</a>
                            }
                            else
                            {
                                <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                            }
                        }
                        <span class="pagination-ellipsis" aria-hidden="true">…</span>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                    </div>
                </nav>
            </div>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="card-footer text-muted small">
            Showing @Model.TotalCount @(Model.TotalCount == 1 ? "customer" : "customers")
        </div>
    }
</div>

