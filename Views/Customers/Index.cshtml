@model RentalSphere.Modules.CustomerManagement.ViewModels.CustomerIndexViewModel
@{
    ViewData["Title"] = "Customers";
    var canWrite = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Staff);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people"></i> Customers</h2>
    @if (canWrite)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add customer
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger">@e</div> }

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-6">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name or email..." />
        </div>
        <div class="col-md-4">
            <select name="loyaltyTier" class="form-select" asp-items="@(new SelectList(Model.LoyaltyTiers, "Value", "Text", Model.LoyaltyFilter))">
            </select>
        </div>
        <div class="col-md-2">
            <button class="btn btn-outline-primary w-100"><i class="bi bi-search"></i> Filter</button>
        </div>
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>
                        <a class="link-light text-decoration-none" href="@Model.SortUrl("name")">Name@(Model.Sort == "name" ? " ▲" : Model.Sort == "name_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="link-light text-decoration-none" href="@Model.SortUrl("email")">Email@(Model.Sort == "email" ? " ▲" : Model.Sort == "email_desc" ? " ▼" : "")</a>
                    </th>
                    <th>Phone</th>
                    <th>
                        <a class="link-light text-decoration-none" href="@Model.SortUrl("tier")">Loyalty@(Model.Sort == "tier" ? " ▲" : Model.Sort == "tier_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="link-light text-decoration-none" href="@Model.SortUrl("registered")">Registered@(Model.Sort == "registered" ? " ▲" : Model.Sort == "registered_desc" ? " ▼" : "")</a>
                    </th>
                    <th>Status</th>
                    @if (canWrite)
                    {
                        <th class="text-end">Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="@(canWrite ? 7 : 6)" class="text-center text-muted py-4">No customers match your filters.</td></tr>
                }
                @foreach (var c in Model.Items)
                {
                    var tierClass = c.LoyaltyTier switch
                    {
                        "Platinum" => "bg-dark",
                        "Gold" => "bg-warning text-dark",
                        "Silver" => "bg-secondary",
                        _ => "bg-bronze",
                    };
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@c.CustomerID">@c.FirstName @c.LastName</a></td>
                        <td>@c.Email</td>
                        <td>@(c.Phone ?? "—")</td>
                        <td><span class="badge @tierClass">@c.LoyaltyTier</span></td>
                        <td><small>@c.DateRegistered.ToString("yyyy-MM-dd")</small></td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        @if (canWrite)
                        {
                            <td class="text-end">
                                <a asp-action="Edit" asp-route-id="@c.CustomerID" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center">
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">‹ Prev</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next ›</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
</div>

<style>
    .badge.bg-bronze { background-color: #cd7f32; color: #fff; }
</style>
