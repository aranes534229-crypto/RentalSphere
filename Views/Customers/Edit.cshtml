@model RentalSphere.Modules.CustomerManagement.ViewModels.CustomerEditViewModel
@{
    var isMyProfile = ViewData["IsMyProfile"] is true;
    ViewData["Title"] = isMyProfile
        ? "Edit my profile"
        : $"Edit {Model.Form.FirstName} {Model.Form.LastName}";
    var isAdmin = User.IsInRole(RoleNames.Admin);
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">
        <h3 class="card-title mb-3"><i class="bi bi-pencil"></i> @(isMyProfile ? "Edit my profile" : "Edit customer")</h3>
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Form.CustomerID" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.FirstName" class="form-label"></label>
                    <input asp-for="Form.FirstName" class="form-control" />
                    <span asp-validation-for="Form.FirstName" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.LastName" class="form-label"></label>
                    <input asp-for="Form.LastName" class="form-control" />
                    <span asp-validation-for="Form.LastName" class="text-danger"></span>
                </div>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.Email" class="form-label"></label>
                    <input asp-for="Form.Email" class="form-control" />
                    <span asp-validation-for="Form.Email" class="text-danger"></span>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.Phone" class="form-label"></label>
                    <input asp-for="Form.Phone" class="form-control" />
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Form.Address" class="form-label"></label>
                <input asp-for="Form.Address" class="form-control" />
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.City" class="form-label"></label>
                    <input asp-for="Form.City" class="form-control" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="Form.PostalCode" class="form-label"></label>
                    <input asp-for="Form.PostalCode" class="form-control" />
                </div>
            </div>
            @{
                var customerId = Model.Form.CustomerID;
                var overrideLink = isAdmin
                    ? Url.Action("OverrideTier", "Customers", new { id = customerId })
                    : null;
            }
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">Loyalty tier</label>
                    <div>
                        <span class="badge bg-secondary">Bronze</span>
                        <span class="text-muted small ms-2">Set automatically from rental spend.</span>
                    </div>
                </div>
                @if (isAdmin)
                {
                    <div class="col-md-6 mb-3 form-check mt-4 ms-3">
                        <input asp-for="Form.IsActive" class="form-check-input" />
                        <label asp-for="Form.IsActive" class="form-check-label"></label>
                    </div>
                }
            </div>
            @if (isAdmin)
            {
                <div class="alert alert-info py-2 mb-3 d-flex justify-content-between align-items-center">
                    <span class="small mb-0">
                        <i class="bi bi-shield-lock"></i>
                        Tier is system-managed. To pin a manual override (e.g. VIP), use Override tier.
                    </span>
                    <a asp-action="OverrideTier" asp-route-id="@customerId" class="btn btn-sm btn-warning">
                        <i class="bi bi-pencil-square"></i> Override tier
                    </a>
                </div>
            }
            <button type="submit" class="btn btn-primary"><i class="bi bi-check-circle"></i> Save</button>
            @if (isMyProfile)
            {
                <a asp-action="MyProfile" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to my profile
                </a>
            }
            else
            {
                <a asp-action="Details" asp-route-id="@Model.Form.CustomerID" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Back to details
                </a>
            }
        </form>
    </div>
</div>