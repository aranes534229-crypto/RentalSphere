@model List<RentalSphere.Identity.Models.ViewModels.UserListItemViewModel>
@{
    ViewData["Title"] = "Accounts & Roles";
    var search = ViewData["Search"] as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-people-fill"></i> Accounts &amp; Roles</h2>
    <a asp-action="Create" class="btn btn-primary">
        <i class="bi bi-person-plus"></i> Create User
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success">@s</div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger">@e</div> }

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Search by email or name..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i> Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No users found.</td></tr>
                }
                @foreach (var u in Model)
                {
                    <tr>
                        <td>@u.Email</td>
                        <td>@u.FirstName @u.LastName</td>
                        <td>
                            @foreach (var r in u.Roles)
                            {
                                <span class="badge bg-secondary me-1">@r</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="badge bg-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Disabled</span>
                            }
                        </td>
                        <td>@u.DateRegistered.ToString("yyyy-MM-dd")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-pencil"></i></a>
                            <a asp-action="ManageRoles" asp-route-id="@u.Id" class="btn btn-sm btn-outline-info"><i class="bi bi-person-gear"></i></a>
                            <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-outline-warning" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                    <i class="bi bi-@(u.IsActive ? "pause" : "play")-fill"></i>
                                </button>
                            </form>
                            <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
