@model RentalSphere.Identity.Models.ViewModels.AccountsAdminIndexViewModel
@{
    ViewData["Title"] = "Accounts & Roles";
    var search = Model.Search;
    var hasFilter = !string.IsNullOrWhiteSpace(search);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var isAdmin = User.IsInRole(RoleNames.Admin);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-people-fill"></i> Accounts &amp; Roles</h2>
        <small class="text-muted">Manage user accounts, roles, and activation status.</small>
    </div>
    <a asp-action="Create" class="btn btn-primary accounts-admin-add-btn">
        <i class="bi bi-person-plus"></i> Create User
    </a>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 accounts-admin-filter-form" id="accountsAdminFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="search" name="search" value="@search" class="form-control accounts-admin-filter-control"
                   placeholder="Search by email or name..." aria-label="Search users" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="accountsAdminPageSize" value="@Model.PageSize" />
</form>

<div class="accounts-admin-main-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle accounts-admin-table">
            <thead class="accounts-admin-table-header">
                <tr>
                    <th>Email</th>
                    <th>Name</th>
                    <th>Roles</th>
                    <th>Status</th>
                    <th>Registered</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="p-0">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-people" style="font-size: 2.5rem;"></i>
                            <p class="mb-1 mt-2">@(hasFilter ? "No users match your search." : "No users found.")</p>
                            @if (hasFilter)
                            {
                                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Show all
                                </a>
                            }
                        </div>
                    </td></tr>
                }
                @foreach (var u in Model.Items)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@u.Id" class="accounts-admin-name-link">@u.Email</a></td>
                        <td>@u.FirstName @u.LastName</td>
                        <td>
                            @if (u.Roles.Any())
                            {
                                @foreach (var r in u.Roles)
                                {
                                    <span class="text-@(u.IsActive ? "success" : "danger")">@r</span>
                                }
                            }
                            else
                            {
                                <span class="text-muted small fst-italic">None assigned</span>
                            }
                        </td>
                        <td>
                            @if (u.IsActive)
                            {
                                <span class="text-success">Active</span>
                            }
                            else
                            {
                                <span class="text-danger">Disabled</span>
                            }
                        </td>
                        <td><small>@u.DateRegistered.ToString("yyyy-MM-dd")</small></td>
                        <td class="text-end">
                            @* Staff users can see/edit accounts but cannot activate/deactivate, manage roles, or delete —
                               those actions escalate to Admin per the RBAC rules in CLAUDE.md. *@
                            <a asp-action="Details" asp-route-id="@u.Id" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                            <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                            @if (isAdmin)
                            {
                                <a asp-action="ManageRoles" asp-route-id="@u.Id" class="btn btn-sm btn-outline-info" title="Manage roles"><i class="bi bi-person-gear"></i></a>
                                <form asp-action="ToggleActive" asp-route-id="@u.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-warning" title="@(u.IsActive ? "Deactivate" : "Activate")">
                                        <i class="bi bi-@(u.IsActive ? "pause" : "play")-fill"></i>
                                    </button>
                                </form>
                                <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page"
                        onchange="document.getElementById('accountsAdminPageSize').value = this.value; document.getElementById('accountsAdminFilterForm').submit();">
                    @foreach (var ps in Model.PageSizes)
                    {
                        <option value="@ps.Value" selected="@(ps.Value == Model.PageSize.ToString() ? true : false)">@ps.Text</option>
                    }
                </select>
            </div>
            <nav>
                <div class="d-flex align-items-center accounts-admin-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="card-footer text-muted small">
            Showing @Model.TotalCount user@(Model.TotalCount == 1 ? "" : "s")
        </div>
    }
</div>
