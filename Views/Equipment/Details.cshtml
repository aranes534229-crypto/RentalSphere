@model RentalSphere.Modules.Equipment.DTOs.EquipmentDetailsDto
@{
    ViewData["Title"] = Model.Name;
    var canWrite = User.IsInRole(RoleNames.Admin) || User.IsInRole(RoleNames.Staff);
    var canDelete = User.IsInRole(RoleNames.Admin);
    var isCustomer = User.IsInRole(RoleNames.Customer);

    var rangeStart = Model.RangeStart ?? DateTime.UtcNow.Date;
    var rangeEnd = Model.RangeEnd ?? rangeStart.AddDays(1);
    var rangeLabel = Model.RangeStart.HasValue
        ? $"{rangeStart:MMM d, yyyy} – {rangeEnd:MMM d, yyyy}"
        : "today";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Equipment catalog</a></li>
        <li class="breadcrumb-item active">@Model.Name</li>
    </ol>
</nav>

<form method="get" class="card mb-3">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">From</label>
                <input type="date" name="start" value="@rangeStart.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">To</label>
                <input type="date" name="end" value="@rangeEnd.ToString("yyyy-MM-dd")" class="form-control" />
            </div>
            <div class="col-md-4 d-flex gap-2">
                <button type="submit" class="btn btn-outline-primary flex-grow-1">
                    <i class="bi bi-calendar-check"></i> Check availability
                </button>
                <a asp-action="Details" asp-route-id="@Model.EquipmentID" class="btn btn-outline-secondary" title="Reset to today">
                    <i class="bi bi-x-lg"></i>
                </a>
            </div>
        </div>
    </div>
</form>

<div class="row g-3">
    <div class="col-md-4">
        @if (!string.IsNullOrEmpty(Model.ImageURL))
        {
            <img src="@Model.ImageURL" alt="@Model.Name" class="img-fluid rounded border" />
        }
        else
        {
            <div class="bg-light rounded border d-flex align-items-center justify-content-center" style="height: 240px;">
                <i class="bi bi-image text-muted" style="font-size: 3rem;"></i>
            </div>
        }
    </div>
    <div class="col-md-8">
        <div class="card">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h3 class="card-title mb-0">@Model.Name</h3>
                    <partial name="_StatusBadge" model="Model.Status" />
                </div>
                <p class="text-muted mb-3">@Model.CategoryName</p>

                <dl class="row mb-3">
                    <dt class="col-sm-4">Daily rate</dt>
                    <dd class="col-sm-8"><strong class="text-success fs-5">&#8369;@Model.DailyRate.ToString("N2")</strong></dd>

                    <dt class="col-sm-4">Stock quantity</dt>
                    <dd class="col-sm-8">@Model.StockQuantity (total tracked items)</dd>

                    <dt class="col-sm-4">Serial prefix</dt>
                    <dd class="col-sm-8"><code>@(Model.SerialPrefix ?? "EQ-")</code> <small class="text-muted">new items auto-generate as <code>@(Model.SerialPrefix ?? "EQ-")0001</code>, <code>@(Model.SerialPrefix ?? "EQ-")0002</code>, &hellip;</small></dd>

                    <dt class="col-sm-4">Availability</dt>
                    <dd class="col-sm-8">
                        @if (Model.AvailableCount > 0)
                        {
                            <span class="badge bg-success mb-1">Available</span>
                            <div class="text-muted small">
                                @Model.AvailableCount of @Model.TotalStock item@(Model.TotalStock == 1 ? "" : "s") left
                                @if (Model.RangeStart.HasValue)
                                {
                                    <span>(for @rangeLabel)</span>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="badge bg-danger mb-1">Fully booked</span>
                            <div class="text-muted small">
                                Out of stock
                                @if (Model.RangeStart.HasValue)
                                {
                                    <span>for @rangeLabel</span>
                                }
                            </div>
                        }
                    </dd>

                    <dt class="col-sm-4">Added</dt>
                    <dd class="col-sm-8">@Model.DateAdded.ToString("yyyy-MM-dd")</dd>

                    @if (!string.IsNullOrEmpty(Model.Description))
                    {
                        <dt class="col-sm-4">Description</dt>
                        <dd class="col-sm-8">@Model.Description</dd>
                    }
                </dl>

                <div class="mt-3">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> @(isCustomer ? "Back to browse" : "Back")
                    </a>
                    @if (isCustomer && Model.Status == "Available" && Model.AvailableCount > 0)
                    {
                        @* ponytail: pre-filling ?equipmentId= on the reservation create form isn't wired today; the customer picks the equipment again on the form. *@
                        <a asp-controller="Reservations" asp-action="Create" class="btn btn-success">
                            <i class="bi bi-calendar-plus"></i> Reserve this
                        </a>
                    }
                    @if (canWrite)
                    {
                        <a asp-action="Edit" asp-route-id="@Model.EquipmentID" class="btn btn-primary">
                            <i class="bi bi-pencil"></i> Edit
                        </a>
                    }
                    @if (canDelete)
                    {
                        <a asp-action="Delete" asp-route-id="@Model.EquipmentID" class="btn btn-outline-danger">
                            <i class="bi bi-trash"></i> Delete
                        </a>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
