@model RentalSphere.Modules.Equipment.ViewModels.EquipmentIndexViewModel
@{
    ViewData["Title"] = "Equipment catalog";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var canWrite = !isCustomer && (isAdmin || isStaff);
    var canDelete = isAdmin;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryFilter.HasValue;
    // ponytail: LowStockThreshold is the cutoff between "Available" and
    // "Low Stock". 5 is a deliberate local default — change here if the
    // business wants a different warning level. The view uses this to
    // override the manually-entered Status (e.g. "Retired") only when
    // the catalog says "Available"; other statuses still win.
    const int LowStockThreshold = 5;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam"></i> Equipment catalog</h2>
        <small class="text-muted d-block mt-1">
            @(isCustomer
                ? "Browse the rental catalog."
                : "Manage equipment types in the catalog. Use Equipment units to track individual tracked units.")
        </small>
    </div>
    @if (isStaff || isAdmin)
    {
        <a asp-action="Create" class="btn equipment-add-btn">
            <i class="bi bi-plus-circle"></i> Add Equipment
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 equipment-filter-form" id="equipmentFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="text" name="search" value="@Model.Search" class="form-control equipment-filter-control" id="equipmentSearchInput" placeholder="Search..." autocomplete="off" />
        </div>
        <div class="col-md-3">
            <select name="categoryId" class="form-select equipment-filter-control" id="equipmentCategorySelect" asp-items="@(new SelectList(Model.Categories, "Value", "Text", Model.CategoryFilter))">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="equipmentPageSize" value="@Model.PageSize" />
</form>

@if (isCustomer)
{
    @* ponytail: card grid is customer-only. Staff keep the table for catalog ops. *@
    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-x-lg"></i> Reset filters
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var eq in Model.Items)
            {
                // ponytail: same stock-derived label as the table view so a
                // customer sees "Out of Stock" instead of a misleading green
                // "Available" badge when the catalog is at zero.
                var displayStatus = eq.StockQuantity <= 0
                    ? "Out of Stock"
                    : (eq.StockQuantity <= LowStockThreshold ? "Low Stock" : eq.Status);
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(eq.ImageURL))
                        {
                            <img src="@eq.ImageURL" alt="@eq.Name" class="card-img-top" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-image text-muted" style="font-size: 2.5rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted text-uppercase">@eq.CategoryName</small>
                            <h5 class="card-title mb-1">@eq.Name</h5>
                            <p class="text-success fw-semibold mb-2">
                                &#8369;@eq.DailyRate.ToString("N2")
                                <small class="text-muted fw-normal">/ day</small>
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <partial name="_StatusBadge" model="displayStatus" />
                                <a asp-action="Details" asp-route-id="@eq.EquipmentID" class="btn btn-sm btn-primary">
                                    View <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer mt-3 d-flex justify-content-between align-items-center bg-white border rounded">
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount
            </small>
            <nav>
                <div class="d-flex align-items-center equipment-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
}
else
{
    <div class="equipment-main-card">
        <div class="table-responsive">
            <table class="table table-hover align-middle equipment-table">
                <thead class="equipment-table-header">
                    <tr>
                        <th>
                            <a class="equipment-header-link" href="@Model.SortUrl("name")">Name@(Model.Sort == "name" ? " ▲" : Model.Sort == "name_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Category</th>
                        <th class="text-end">
                            <a class="equipment-header-link d-inline-block" href="@Model.SortUrl("rate")">Daily rate@(Model.Sort == "rate" ? " ▲" : Model.Sort == "rate_desc" ? " ▼" : "")</a>
                        </th>
                        <th class="text-end">
                            <a class="equipment-header-link d-inline-block" href="@Model.SortUrl("stock")">Stock@(Model.Sort == "stock" ? " ▲" : Model.Sort == "stock_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Status</th>
                        <th>
                            <a class="equipment-header-link" href="@Model.SortUrl("added")">Added@(Model.Sort == "added" ? " ▲" : Model.Sort == "added_desc" ? " ▼" : "")</a>
                        </th>
                        @if (canWrite)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@(canWrite ? 7 : 6)" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var eq in Model.Items)
                    {
                        // ponytail: when the row is in the catalog-level "Available"
                        // state, derive the user-facing label from stock: 0 -> Out of
                        // Stock, <= LowStockThreshold -> Low Stock, else Available.
                        // Rows that staff/admin already marked Unavailable or Retired
                        // keep their manual state so retirement isn't masked.
                        var displayStatus = eq.Status;
                        if (eq.Status == "Available")
                        {
                            displayStatus = eq.StockQuantity <= 0
                                ? "Out of Stock"
                                : (eq.StockQuantity <= LowStockThreshold ? "Low Stock" : "Available");
                        }
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@eq.EquipmentID" class="equipment-name-link">@eq.Name</a></td>
                            <td>@eq.CategoryName</td>
                            <td class="text-end">&#8369;@eq.DailyRate.ToString("N2")</td>
                            <td class="text-end">@eq.StockQuantity</td>
                            <td><partial name="_StatusBadge" model="displayStatus" /></td>
                            <td><small>@eq.DateAdded.ToString("yyyy-MM-dd")</small></td>
                            @if (canWrite)
                            {
                                <td class="text-end">
                                    <div class="dropdown">
                                        <button class="btn btn-sm btn-link p-0 equipment-action-btn" type="button" data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                            <i class="bi bi-three-dots-vertical"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end equipment-popout">
                                            <li><a class="dropdown-item" asp-action="Details" asp-route-id="@eq.EquipmentID"><i class="bi bi-eye me-2"></i>View details</a></li>
                                            <li><a class="dropdown-item" asp-action="Edit" asp-route-id="@eq.EquipmentID"><i class="bi bi-pencil me-2"></i>Edit equipment</a></li>
                                            @if (canDelete)
                                            {
                                                <li><a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@eq.EquipmentID"><i class="bi bi-trash me-2"></i>Delete</a></li>
                                            }
                                        </ul>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center py-3">
                <div class="d-flex align-items-center">
                    <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                    <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page" onchange="document.getElementById('equipmentPageSize').value = this.value; document.getElementById('equipmentFilterForm').submit();">
                        @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                        @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                        @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                        @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                    </select>
                </div>
                <nav>
                    <div class="d-flex align-items-center equipment-pagination" style="gap: 6px;">
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                        <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            if (p == Model.Page)
                            {
                                <a class="pagination-pill active" href="#">@p</a>
                            }
                            else
                            {
                                <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                            }
                        }
                        <span class="pagination-ellipsis">…</span>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                        <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                    </div>
                </nav>
            </div>
        }
    </div>
}
