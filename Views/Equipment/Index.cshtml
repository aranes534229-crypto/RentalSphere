@model RentalSphere.Modules.Equipment.ViewModels.EquipmentIndexViewModel
@{
    ViewData["Title"] = "Equipment catalog";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var canWrite = !isCustomer && (isAdmin || isStaff);
    var canDelete = isAdmin;
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || Model.CategoryFilter.HasValue;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam"></i> Equipment catalog</h2>
        <small class="text-muted">
            @(isCustomer
                ? "Browse the rental catalog."
                : "Manage equipment types in the catalog. Use Equipment units to track individual tracked units.")
        </small>
    </div>
    @if (canWrite)
    {
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add equipment
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control" placeholder="Search by name..." />
        </div>
        <div class="col-md-4">
            <select name="categoryId" class="form-select" asp-items="@(new SelectList(Model.Categories, "Value", "Text", Model.CategoryFilter))">
                <option value="">All categories</option>
            </select>
        </div>
        <div class="col-md-3 d-flex gap-1">
            <button type="submit" class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

@if (isCustomer)
{
    @* ponytail: card grid is customer-only. Staff keep the table for catalog ops. *@
    @if (!Model.Items.Any())
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                @if (hasFilter)
                {
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                        <i class="bi bi-x-lg"></i> Reset filters
                    </a>
                }
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var eq in Model.Items)
            {
                <div class="col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrEmpty(eq.ImageURL))
                        {
                            <img src="@eq.ImageURL" alt="@eq.Name" class="card-img-top" style="height: 180px; object-fit: cover;" />
                        }
                        else
                        {
                            <div class="bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                                <i class="bi bi-image text-muted" style="font-size: 2.5rem;"></i>
                            </div>
                        }
                        <div class="card-body d-flex flex-column">
                            <small class="text-muted text-uppercase">@eq.CategoryName</small>
                            <h5 class="card-title mb-1">@eq.Name</h5>
                            <p class="text-success fw-semibold mb-2">
                                &#8369;@eq.DailyRate.ToString("N2")
                                <small class="text-muted fw-normal">/ day</small>
                            </p>
                            <div class="mt-auto d-flex justify-content-between align-items-center">
                                <partial name="_StatusBadge" model="eq.Status" />
                                <a asp-action="Details" asp-route-id="@eq.EquipmentID" class="btn btn-sm btn-primary">
                                    View <i class="bi bi-arrow-right"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }

    @if (Model.TotalPages > 1)
    {
        <div class="card-footer mt-3 d-flex justify-content-between align-items-center bg-white border rounded">
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount
            </small>
            <nav>
                <ul class="pagination pagination-sm mb-0">
                    <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                        <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                    </li>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        <li class="page-item @(p == Model.Page ? "active" : "")">
                            <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                        </li>
                    }
                    <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                        <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                    </li>
                </ul>
            </nav>
        </div>
    }
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("name")">Name@(Model.Sort == "name" ? " ▲" : Model.Sort == "name_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Category</th>
                        <th class="text-end">
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("rate")">Daily rate@(Model.Sort == "rate" ? " ▲" : Model.Sort == "rate_desc" ? " ▼" : "")</a>
                        </th>
                        <th class="text-end">
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("stock")">Stock@(Model.Sort == "stock" ? " ▲" : Model.Sort == "stock_desc" ? " ▼" : "")</a>
                        </th>
                        <th>Status</th>
                        <th>
                            <a class="link-light text-decoration-none" href="@Model.SortUrl("added")">Added@(Model.Sort == "added" ? " ▲" : Model.Sort == "added_desc" ? " ▼" : "")</a>
                        </th>
                        @if (canWrite)
                        {
                            <th class="text-end">Actions</th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="@(canWrite ? 7 : 6)" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-inbox" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No equipment matches your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var eq in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@eq.EquipmentID">@eq.Name</a></td>
                            <td>@eq.CategoryName</td>
                            <td class="text-end">&#8369;@eq.DailyRate.ToString("N2")</td>
                            <td class="text-end">@eq.StockQuantity</td>
                            <td><partial name="_StatusBadge" model="eq.Status" /></td>
                            <td><small>@eq.DateAdded.ToString("yyyy-MM-dd")</small></td>
                            @if (canWrite)
                            {
                                <td class="text-end">
                                    <a asp-action="Edit" asp-route-id="@eq.EquipmentID" class="btn btn-sm btn-outline-primary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    @if (canDelete)
                                    {
                                        <a asp-action="Delete" asp-route-id="@eq.EquipmentID" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></a>
                                    }
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    </div>
}
