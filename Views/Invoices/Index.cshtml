@model RentalSphere.Modules.Billing.ViewModels.InvoiceIndexViewModel
@{
    ViewData["Title"] = "Invoices";
    var hasFilter = !string.IsNullOrWhiteSpace(Model.Search) || !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-receipt"></i> Invoices</h2>
        <small class="text-muted">
            Track issued invoices and their payment status.
        </small>
    </div>
    @* Invoice generation originates from the Rental Transaction return flow,
       so there is no "Add" entry point on this index. *@
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 billing-filter-form" id="billingFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-3">
            <select name="statusFilter" class="form-select billing-filter-control" id="billingStatusSelect"
                    asp-items="@(new Microsoft.AspNetCore.Mvc.Rendering.SelectList(Model.Statuses, "Value", "Text", Model.StatusFilter))"
                    onchange="this.form.submit();">
            </select>
        </div>
        <div class="col-md-5">
            <input type="text" name="search" value="@Model.Search" class="form-control billing-filter-control"
                   placeholder="Search invoice # or customer name…"
                   onkeyup="clearTimeout(this._t); this._t=setTimeout(()=>{ this.form.submit(); }, 400);" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="billingPageSize" value="@Model.PageSize" />
    <input type="hidden" name="sort" value="@Model.Sort" />
</form>

<div class="billing-main-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle billing-table">
            <thead class="billing-table-header">
                <tr>
                    <th>
                        <a class="billing-header-link" href="@Model.SortUrl("number")">Invoice #@(Model.Sort == "number" ? " ▲" : Model.Sort == "number_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="billing-header-link" href="@Model.SortUrl("date")">Date@(Model.Sort == "date" ? " ▲" : Model.Sort == "date_desc" ? " ▼" : "")</a>
                    </th>
                    <th>
                        <a class="billing-header-link" href="@Model.SortUrl("customer")">Customer@(Model.Sort == "customer" ? " ▲" : Model.Sort == "customer_desc" ? " ▼" : "")</a>
                    </th>
                    <th class="text-end">
                        <a class="billing-header-link" href="@Model.SortUrl("total")">Total@(Model.Sort == "total" ? " ▲" : Model.Sort == "total_desc" ? " ▼" : "")</a>
                    </th>
                    <th class="text-end">Paid</th>
                    <th class="text-end">Balance</th>
                    <th>
                        <a class="billing-header-link" href="@Model.SortUrl("due")">Due@(Model.Sort == "due" ? " ▲" : Model.Sort == "due_desc" ? " ▼" : "")</a>
                    </th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="10" class="p-0">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-receipt" style="font-size: 2.5rem;"></i>
                            <p class="mb-1 mt-2">No invoices match your filters.</p>
                            @if (hasFilter)
                            {
                                <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Reset filters
                                </a>
                            }
                        </div>
                    </td></tr>
                }
                @foreach (var i in Model.Items)
                {
                    var balance = i.Balance;
                    <tr class="@(i.Status == "Unpaid" || balance > 0 ? "table-warning" : "")">
                        <td><code>@i.InvoiceNumber</code></td>
                        <td><small>@i.InvoiceDate.ToString("yyyy-MM-dd")</small></td>
                        <td>@i.CustomerName</td>
                        <td class="text-end">₱@i.TotalAmount.ToString("N2")</td>
                        <td class="text-end">₱@i.AmountPaid.ToString("N2")</td>
                        <td class="text-end">₱@balance.ToString("N2")</td>
                        <td><small>@(i.DueDate?.ToString("yyyy-MM-dd") ?? "—")</small></td>
                        <td><partial name="_StatusBadge" model="i.Status" /></td>
                        <td class="text-end">
                            <div class="dropdown">
                                <button class="btn btn-sm btn-link p-0 billing-action-btn" type="button"
                                        data-bs-toggle="dropdown" aria-expanded="false" aria-label="Actions">
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end billing-popout">
                                    <li><a class="dropdown-item" asp-action="Details" asp-route-id="@i.InvoiceID"><i class="bi bi-eye me-2"></i>Open</a></li>
                                </ul>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <label for="billingPageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                <select id="billingPageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page"
                        onchange="document.getElementById('billingPageSize').value = this.value; document.getElementById('billingFilterForm').submit();">
                    @if (Model.PageSize == 5) { <option value="5" selected>5</option> } else { <option value="5">5</option> }
                    @if (Model.PageSize == 10) { <option value="10" selected>10</option> } else { <option value="10">10</option> }
                    @if (Model.PageSize == 20) { <option value="20" selected>20</option> } else { <option value="20">20</option> }
                    @if (Model.PageSize == 50) { <option value="50" selected>50</option> } else { <option value="50">50</option> }
                </select>
            </div>
            <small class="text-muted">
                Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                of @Model.TotalCount
            </small>
            <nav>
                <div class="d-flex align-items-center billing-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @for (var p = 1; p <= Model.TotalPages; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <span class="pagination-ellipsis" aria-hidden="true">…</span>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="card-footer text-muted small">
            Showing @Model.TotalCount invoice@(Model.TotalCount == 1 ? "" : "s")
        </div>
    }
</div>
