@model RentalSphere.Modules.Billing.DTOs.PaymentCreateDto
@{
    ViewData["Title"] = "Record Payment";
    var invoice = ViewBag.Invoice as RentalSphere.Modules.Billing.DTOs.InvoiceDetailsDto;
    var balance = invoice is null ? 0m : invoice.TotalAmount - invoice.AmountPaid;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Invoices</a></li>
        @if (invoice is not null)
        {
            <li class="breadcrumb-item">
                <a asp-action="Details" asp-route-id="@invoice.InvoiceID">@invoice.InvoiceNumber</a>
            </li>
        }
        <li class="breadcrumb-item active">Record payment</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-0"><i class="bi bi-cash-coin"></i> Record payment</h1>
        <small class="text-muted">Apply a payment against an outstanding invoice.</small>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to invoices</a>
</div>

@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

@if (invoice is null)
{
    <div class="alert alert-warning">Invoice not found.</div>
}
else
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-3">
                    <div class="text-muted small">Invoice</div>
                    <div><code class="fs-6">@invoice.InvoiceNumber</code></div>
                </div>
                <div class="col-md-3">
                    <div class="text-muted small">Customer</div>
                    <div>@invoice.CustomerName</div>
                </div>
                <div class="col-md-2">
                    <div class="text-muted small">Status</div>
                    <div><partial name="_StatusBadge" model="invoice.Status" /></div>
                </div>
                <div class="col-md-2 text-end">
                    <div class="text-muted small">Total</div>
                    <div>&#8369;@invoice.TotalAmount.ToString("N2")</div>
                </div>
                <div class="col-md-2 text-end">
                    <div class="text-muted small">Balance</div>
                    <div class="text-danger fs-5 fw-semibold">&#8369;@balance.ToString("N2")</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="InvoiceID" />

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="PaymentDate" class="form-label"></label>
                        <input asp-for="PaymentDate" type="date" class="form-control" required />
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Amount" class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">&#8369;</span>
                            <input asp-for="Amount" type="number" step="0.01" min="0.01" max="@balance"
                                   class="form-control" required />
                        </div>
                        <div class="form-text">Maximum: &#8369;@balance.ToString("N2")</div>
                    </div>
                    <div class="col-md-4">
                        <label asp-for="Method" class="form-label"></label>
                        <select asp-for="Method" class="form-select" required>
                            <option value="Cash">Cash</option>
                            <option value="BankTransfer">Bank Transfer</option>
                            <option value="Check">Check</option>
                            <option value="Other">Other</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="ReferenceNumber" class="form-label"></label>
                        <input asp-for="ReferenceNumber" class="form-control" maxlength="100" placeholder="Optional. Check #, transaction id, etc." />
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Notes" class="form-label"></label>
                        <input asp-for="Notes" class="form-control" maxlength="500" placeholder="Optional." />
                    </div>
                </div>

                <div class="mt-3 d-flex justify-content-end">
                    <a asp-action="Details" asp-route-id="@Model.InvoiceID" class="btn btn-outline-secondary me-2">Cancel</a>
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Record payment
                    </button>
                </div>
            </form>
        </div>
    </div>
}
