@model RentalSphere.Modules.Billing.DTOs.InvoiceDetailsDto
@{
    ViewData["Title"] = $"Invoice {Model.InvoiceNumber}";
    var balance = Model.TotalAmount - Model.AmountPaid;
    var isAdmin = User.IsInRole(RentalSphere.Common.Constants.RoleNames.Admin);
    var isStaff = User.IsInRole(RoleNames.Staff);
    var canRecordPayment = (isAdmin || isStaff)
        && Model.Status != "Voided" && Model.Status != "Paid" && balance > 0;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Invoices</a></li>
        <li class="breadcrumb-item active">@Model.InvoiceNumber</li>
    </ol>
</nav>

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 mb-1">Invoice <code>@Model.InvoiceNumber</code></h1>
        <div class="text-muted">Rental transaction
            <a asp-controller="RentalTransactions" asp-action="Details" asp-route-id="@Model.RentalTransactionID">#@Model.RentalTransactionID</a>
        </div>
    </div>
    <div>
        <span class="fs-6"><partial name="_StatusBadge" model="Model.Status" /></span>
    </div>
</div>

@if (TempData["Success"] is string ok) { <div class="alert alert-success alert-dismissible fade show">@ok<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string err) { <div class="alert alert-danger alert-dismissible fade show">@err<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-header">Customer</div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <div class="text-muted small">Name</div>
                        <div>@Model.CustomerName</div>
                    </div>
                    <div class="col-md-6">
                        <div class="text-muted small">Email</div>
                        <div>@Model.CustomerEmail</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-header d-flex justify-content-between">
                <span>Line Items</span>
                <span class="text-muted small">@Model.Lines.Count line(s)</span>
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Type</th>
                            <th>Description</th>
                            <th class="text-end">Qty</th>
                            <th class="text-end">Unit</th>
                            <th class="text-end">Total</th>
                            <th class="text-end">Waived</th>
                            @if (isAdmin) { <th></th> }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lines)
                        {
                            <tr>
                                <td><span class="text-muted">@l.LineType</span></td>
                                <td>@l.Description</td>
                                <td class="text-end">@l.Quantity</td>
                                <td class="text-end">₱@l.UnitAmount.ToString("N2")</td>
                                <td class="text-end">₱@l.LineTotal.ToString("N2")</td>
                                <td class="text-end">
                                    @if (l.WaivedAmount > 0)
                                    {
                                        <span class="text-success">₱@l.WaivedAmount.ToString("N2")</span>
                                    }
                                </td>
                                @if (isAdmin)
                                {
                                    var maxWaive = l.LineTotal - l.WaivedAmount;
                                    if (maxWaive > 0 && Model.Status != "Voided")
                                    {
                                        <td>
                                            <form method="post" asp-action="WaiveLine" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="invoiceLineId" value="@l.InvoiceLineID" />
                                                <input type="hidden" name="amount" value="@maxWaive" />
                                                <input type="hidden" name="reason" value="Admin waive" />
                                                <button class="btn btn-sm btn-outline-warning"
                                                        onclick="return confirm('Waive ₱@maxWaive.ToString("N2") on this line?')">
                                                    Waive
                                                </button>
                                            </form>
                                        </td>
                                    }
                                    else { <td></td> }
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light">
                        <tr>
                            <th colspan="4" class="text-end">Subtotal</th>
                            <th class="text-end">₱@Model.SubTotal.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                        <tr>
                            <th colspan="4" class="text-end">Total Due</th>
                            <th class="text-end">₱@Model.TotalAmount.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                        <tr>
                            <th colspan="4" class="text-end">Balance</th>
                            <th class="text-end text-danger">₱@balance.ToString("N2")</th>
                            <th colspan="2"></th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex justify-content-between">
                <span>Payments</span>
                @if (canRecordPayment)
                {
                    <a asp-action="RecordPayment" asp-route-id="@Model.InvoiceID" class="btn btn-sm btn-success">+ Record Payment</a>
                }
            </div>
            <div class="card-body p-0">
                <table class="table mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Date</th>
                            <th>Method</th>
                            <th>Ref</th>
                            <th class="text-end">Amount</th>
                            <th>Recorded by</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Payments.Any())
                        {
                            <tr><td colspan="5" class="text-center text-muted py-3">No payments recorded yet.</td></tr>
                        }
                        @foreach (var p in Model.Payments)
                        {
                            <tr>
                                <td>@p.PaymentDate.ToString("yyyy-MM-dd")</td>
                                <td>@p.Method</td>
                                <td>@(p.ReferenceNumber ?? "—")</td>
                                <td class="text-end">₱@p.Amount.ToString("N2")</td>
                                <td>@(p.RecordedByUserName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card mb-3">
            <div class="card-header">Invoice Info</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Issued</dt><dd class="col-sm-7">@Model.InvoiceDate.ToString("yyyy-MM-dd")</dd>
                    <dt class="col-sm-5">Due</dt><dd class="col-sm-7">@(Model.DueDate?.ToString("yyyy-MM-dd") ?? "—")</dd>
                    <dt class="col-sm-5">Created by</dt><dd class="col-sm-7">@(Model.CreatedByUserName ?? "—")</dd>
                    @if (Model.Status == "Voided")
                    {
                        <dt class="col-sm-5">Voided</dt><dd class="col-sm-7">@Model.VoidedAt?.ToString("yyyy-MM-dd HH:mm")</dd>
                        <dt class="col-sm-5">Voided by</dt><dd class="col-sm-7">@(Model.VoidedByUserName ?? "—")</dd>
                        <dt class="col-sm-5">Reason</dt><dd class="col-sm-7">@Model.VoidedReason</dd>
                    }
                </dl>
            </div>
        </div>

        @if (isAdmin && Model.Status != "Voided" && Model.AmountPaid == 0)
        {
            <div class="card border-warning">
                <div class="card-header bg-warning-subtle">Admin Actions</div>
                <div class="card-body">
                    <form method="post" asp-action="Void" asp-route-id="@Model.InvoiceID">
                        @Html.AntiForgeryToken()
                        <label class="form-label">Void reason</label>
                        <input type="text" name="reason" class="form-control mb-2" required maxlength="500" />
                        <button class="btn btn-warning w-100"
                                onclick="return confirm('Void this invoice? Cannot be undone.')">
                            Void Invoice
                        </button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to invoices</a>
</div>
