@model string
@{
    // Invoice status -> text color. No badge — plain inline text.
    var cls = Model switch
    {
        "Paid"          => "text-success",
        "PartiallyPaid" => "text-warning",
        "Voided"        => "text-muted",
        "Overdue"       => "text-danger",
        _               => "text-muted"
    };
}
<span class="@cls">@Model</span>