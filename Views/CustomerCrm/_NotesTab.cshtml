@model RentalSphere.Modules.CustomerCrm.ViewModels.CustomerCrmViewModel
@{
    var canEdit = User.IsInRole("Admin") || User.IsInRole("Staff");
}

<div class="row g-3">
    @if (canEdit)
    {
        <div class="col-md-4">
            <div class="crm-main-card">
                <div class="card-header crm-table-header">Add Note</div>
                <div class="card-body">
                    <form asp-action="AddNote" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="CustomerID" value="@Model.NewNote.CustomerID" />
                        <input type="hidden" name="tab" value="notes" />
                        <div class="mb-3">
                            <label class="form-label">Note</label>
                            <textarea name="Body" class="form-control crm-filter-control" rows="5" required maxlength="2000"
                                      placeholder="Interaction summary, observation, or follow-up context…">@Model.NewNote.Body</textarea>
                        </div>
                        <div class="form-check mb-3">
                            <input name="IsFlagged" value="true" type="checkbox"
                                   class="form-check-input" id="IsFlagged_@Model.CustomerID"
                                   @(Model.NewNote.IsFlagged ? "checked" : "") />
                            <label for="IsFlagged_@Model.CustomerID" class="form-check-label">Flag for follow-up</label>
                            @* ASP.NET checkbox binding for non-string bool: include a hidden "false" so unchecked still sends false *@
                            <input type="hidden" name="IsFlagged" value="false" />
                        </div>
                        <button type="submit" class="btn crm-add-btn w-100">
                            <i class="bi bi-plus-lg"></i> Add Note
                        </button>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="@(canEdit ? "col-md-8" : "col-12")">
        @if (canEdit && Model.Notes.Any())
        {
            <form asp-action="MarkAllNotesRead" method="post" class="mb-2 text-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="customerId" value="@Model.CustomerID" />
                <input type="hidden" name="tab" value="notes" />
                <button type="submit" class="btn btn-sm btn-outline-primary crm-action-btn">
                    <i class="bi bi-envelope-open"></i> Mark all as read
                </button>
            </form>
        }
        @if (!Model.Notes.Any())
        {
            <div class="alert alert-info crm-filter-form">No notes yet.</div>
        }
        else
        {
            <div class="list-group crm-table">
                @foreach (var n in Model.Notes)
                {
                    <div class="list-group-item @(n.IsUnreadForCurrentUser ? "table-warning" : "")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                @if (n.IsUnreadForCurrentUser)
                                {
                                    <span class="text-primary crm-table-badge me-2" title="Unread for you">
                                        <i class="bi bi-circle-fill"></i> New
                                    </span>
                                }
                                @if (n.IsFlagged)
                                {
                                    <span class="text-warning crm-table-badge me-2">
                                        <i class="bi bi-flag-fill"></i> Flagged
                                    </span>
                                }
                                <small class="text-muted">
                                    @n.CreatedAt.ToString("yyyy-MM-dd HH:mm") ·
                                    @(string.IsNullOrEmpty(n.CreatedByUserName) ? "System" : n.CreatedByUserName)
                                </small>
                            </div>
                            @if (canEdit)
                            {
                                <form asp-action="ToggleNoteRead" method="post" class="ms-2">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="noteId" value="@n.CustomerNoteID" />
                                    <input type="hidden" name="customerId" value="@Model.CustomerID" />
                                    <input type="hidden" name="tab" value="notes" />
                                    @if (n.IsUnreadForCurrentUser)
                                    {
                                        <input type="hidden" name="makeRead" value="true" />
                                        <button type="submit" class="btn btn-sm btn-outline-primary crm-action-btn" title="Mark as read">
                                            <i class="bi bi-envelope-open"></i> Mark read
                                        </button>
                                    }
                                    else
                                    {
                                        <input type="hidden" name="makeRead" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary crm-action-btn" title="Mark as unread">
                                            <i class="bi bi-envelope"></i> Mark unread
                                        </button>
                                    }
                                </form>
                            }
                        </div>
                        <p class="mb-0 mt-2" style="white-space: pre-wrap;">@n.Body</p>
                    </div>
                }
            </div>
        }
    </div>
</div>
