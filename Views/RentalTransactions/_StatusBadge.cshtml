@model string
@{
    // Rental transaction status -> Bootstrap badge class mapping.
    var cls = Model switch
    {
        "Active"    => "bg-warning text-dark",
        "Returned"  => "bg-success",
        "Cancelled" => "bg-secondary",
        "Overdue"   => "bg-danger",
        _           => "bg-secondary"
    };
}
<span class="badge @cls">@Model</span>
