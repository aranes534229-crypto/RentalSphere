@model dynamic
@{
    // Both RentalTransactionListItemDto and RentalTransactionDetailsDto expose
    // Status + ExpectedReturnDate. The partial renders the persisted status, or
    // "Overdue" (red) when Status=="Active" and the expected return is in the past.
    // No badge — plain inline text with color for at-a-glance status.
    var status = (string)Model.Status;
    var expected = (DateTime)Model.ExpectedReturnDate;
    var display = status == "Active" && expected < DateTime.UtcNow ? "Overdue" : status;

    var cls = display switch
    {
        "Active"    => "text-warning",
        "Returned"  => "text-success",
        "Cancelled" => "text-muted",
        "Overdue"   => "text-danger",
        _           => "text-muted"
    };
}
<span class="@cls">@display</span>