@model RentalSphere.Modules.RentalTransaction.ViewModels.RentalTransactionReturnViewModel
@{
    ViewData["Title"] = $"Return rental #{Model.Transaction.RentalTransactionID}";
    var t = Model.Transaction;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@t.RentalTransactionID">Transaction #@t.RentalTransactionID</a></li>
        <li class="breadcrumb-item active">Return</li>
    </ol>
</nav>

<div class="card">
    <div class="card-body">
        <h3 class="card-title mb-3"><i class="bi bi-arrow-return-left"></i> Record return</h3>

        <div class="alert alert-info d-flex align-items-start" role="alert">
            <i class="bi bi-info-circle me-2 mt-1"></i>
            <div>
                Each pinned unit will be moved from <code>CheckedOut</code> back to
                <code>Available</code>. Use the flag below to flag the transaction for
                the upcoming damage/penalty workflow if anything needs follow-up.
            </div>
        </div>

        <dl class="row mb-3">
            <dt class="col-sm-3">Customer</dt>
            <dd class="col-sm-9">@t.CustomerName</dd>
            <dt class="col-sm-3">Checked out</dt>
            <dd class="col-sm-9">@t.CheckoutDate.ToString("yyyy-MM-dd HH:mm")</dd>
            <dt class="col-sm-3">Expected return</dt>
            <dd class="col-sm-9">@t.ExpectedReturnDate.ToString("yyyy-MM-dd")</dd>
        </dl>

        <form asp-action="Return" asp-route-id="@t.RentalTransactionID" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Form.RentalTransactionID" />

            <div class="mb-3">
                <label asp-for="Form.ConditionNotes" class="form-label"></label>
                <textarea asp-for="Form.ConditionNotes" class="form-control" rows="4" placeholder="e.g., minor scratch on top; all other items clean"></textarea>
                <span asp-validation-for="Form.ConditionNotes" class="text-danger small"></span>
                <small class="form-text text-muted">Free-form notes about the condition of the returned equipment.</small>
            </div>

            <div class="alert alert-warning d-flex align-items-start" role="alert">
                <i class="bi bi-exclamation-circle me-2 mt-1"></i>
                <div class="flex-grow-1">
                    <div class="form-check mb-0">
                        <input asp-for="Form.FlaggedForDamage" class="form-check-input" type="checkbox" />
                        <label asp-for="Form.FlaggedForDamage" class="form-check-label">
                            Flag this return for damage / penalty review
                        </label>
                    </div>
                    <small class="text-muted">Use when equipment was returned damaged, dirty, or late.</small>
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center">
                <a asp-action="Details" asp-route-id="@t.RentalTransactionID" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left"></i> Cancel
                </a>
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle"></i> Complete return
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
