@model RentalSphere.Modules.RentalTransaction.ViewModels.RentalTransactionIndexViewModel
@{
    ViewData["Title"] = Model.IsMineView ? "My Rentals" : "Rental Transactions";
    var isCustomer = User.IsInRole(RoleNames.Customer);
    var isAdmin = User.IsInRole(RoleNames.Admin);
    var canCheckout = isAdmin || User.IsInRole(RoleNames.Staff);
    var hasFilter = !string.IsNullOrWhiteSpace(Model.StatusFilter);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-box-seam"></i> @ViewData["Title"]</h2>
        <small class="text-muted">
            @(Model.IsMineView
                ? "Your past and current rentals."
                : "Track checkouts, returns, and active rentals.")
        </small>
    </div>
    @if (canCheckout && !Model.IsMineView)
    {
        <a asp-action="Checkout" class="btn btn-primary">
            <i class="bi bi-box-arrow-up"></i> New checkout
        </a>
    }
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3">
    <div class="row g-2">
        <div class="col-md-10">
            <select name="statusFilter" class="form-select" asp-items="@(new SelectList(Model.Statuses, "Value", "Text", Model.StatusFilter))">
            </select>
        </div>
        <div class="col-md-2 d-flex gap-1">
            <button class="btn btn-outline-primary flex-grow-1"><i class="bi bi-search"></i> Filter</button>
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" value="@Model.PageSize" />
</form>

@if (Model.IsMineView)
{
    @if (!Model.Items.Any() && string.IsNullOrWhiteSpace(Model.StatusFilter))
    {
        <div class="card">
            <div class="text-center text-muted py-5">
                <i class="bi bi-box" style="font-size: 2.5rem;"></i>
                <p class="mb-1 mt-2">You have no rentals yet.</p>
                <p class="text-muted small">Reservations you check out will appear here.</p>
                <a asp-controller="Reservations" asp-action="MyReservations" class="btn btn-outline-primary mt-2">
                    <i class="bi bi-calendar-event"></i> View my reservations
                </a>
            </div>
        </div>
    }
    else
    {
        var allActive = string.IsNullOrWhiteSpace(Model.StatusFilter);
        var isActive = Model.StatusFilter == "Active";
        var isReturned = Model.StatusFilter == "Returned";
        var isOther = !allActive && !isActive && !isReturned;

        <ul class="nav nav-pills mb-3 gap-1">
            <li class="nav-item">
                <a class="nav-link @(allActive ? "active text-white bg-secondary" : "text-dark")"
                   style="@(allActive ? "" : "background-color: #f1f3f5;")"
                   href="@Url.Action("Index", new { statusFilter = "", page = 1, pageSize = Model.PageSize })">All <span class="badge bg-light text-dark ms-1">@Model.TotalCount</span></a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isActive ? "active text-white bg-warning" : "text-dark")"
                   style="@(isActive ? "" : "background-color: #f1f3f5;")"
                   href="@Url.Action("Index", new { statusFilter = "Active", page = 1, pageSize = Model.PageSize })">Active <span class="badge bg-warning text-dark ms-1">@Model.ActiveCount</span></a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(isReturned ? "active text-white bg-success" : "text-dark")"
                   style="@(isReturned ? "" : "background-color: #f1f3f5;")"
                   href="@Url.Action("Index", new { statusFilter = "Returned", page = 1, pageSize = Model.PageSize })">Returned <span class="badge bg-success ms-1">@Model.ReturnedCount</span></a>
            </li>
            @if (Model.OtherCount > 0 || isOther)
            {
                <li class="nav-item">
                    <a class="nav-link @(isOther ? "active text-white bg-secondary" : "text-dark")"
                       style="@(isOther ? "" : "background-color: #f1f3f5;")"
                       href="@Url.Action("Index", new { statusFilter = "Cancelled", page = 1, pageSize = Model.PageSize })">Other <span class="badge bg-secondary ms-1">@Model.OtherCount</span></a>
                </li>
            }
        </ul>

        <div class="card">
            <div class="table-responsive">
                <table class="table table-striped table-hover mb-0 align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>#</th>
                            <th>Checked out</th>
                            <th>Expected return</th>
                            <th>Returned</th>
                            <th class="text-end">Amount</th>
                            <th>Status</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Items.Any())
                        {
                            <tr><td colspan="7" class="p-0">
                                <div class="text-center text-muted py-5">
                                    <i class="bi bi-box" style="font-size: 2.5rem;"></i>
                                    <p class="mb-1 mt-2">No rentals match this filter.</p>
                                    <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Show all
                                    </a>
                                </div>
                            </td></tr>
                        }
                        @foreach (var t in Model.Items)
                        {
                            <tr>
                                <td><a asp-action="Details" asp-route-id="@t.RentalTransactionID">#@t.RentalTransactionID</a></td>
                                <td><small>@t.CheckoutDate.ToString("yyyy-MM-dd")</small></td>
                                <td><small>@t.ExpectedReturnDate.ToString("yyyy-MM-dd")</small></td>
                                <td><small>@(t.ReturnDate?.ToString("yyyy-MM-dd") ?? "—")</small></td>
                                <td class="text-end">&#8369;@t.TotalAmount.ToString("N2")</td>
                                <td><partial name="_StatusBadge" model="t.Status" /></td>
                                <td class="text-end">
                                    <a asp-action="Details" asp-route-id="@t.RentalTransactionID" class="btn btn-sm btn-outline-primary" title="Open"><i class="bi bi-box-arrow-up-right"></i></a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (Model.TotalCount > 0)
            {
                <div class="card-footer d-flex justify-content-between align-items-center">
                    <small class="text-muted">
                        Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                        of @Model.TotalCount
                    </small>
                    <nav>
                        <ul class="pagination pagination-sm mb-0">
                            <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                                <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                            </li>
                            @for (var p = 1; p <= Model.TotalPages; p++)
                            {
                                <li class="page-item @(p == Model.Page ? "active" : "")">
                                    <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                                </li>
                            }
                            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                                <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                            </li>
                        </ul>
                    </nav>
                </div>
            }
        </div>
    }
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-striped table-hover mb-0 align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Reservation</th>
                        <th>Checked out</th>
                        <th>Expected return</th>
                        <th>Returned</th>
                        <th class="text-end">Amount</th>
                        <th>Status</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="9" class="p-0">
                            <div class="text-center text-muted py-5">
                                <i class="bi bi-box" style="font-size: 2.5rem;"></i>
                                <p class="mb-1 mt-2">No transactions match your filters.</p>
                                @if (hasFilter)
                                {
                                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary mt-2">
                                        <i class="bi bi-x-lg"></i> Reset filters
                                    </a>
                                }
                            </div>
                        </td></tr>
                    }
                    @foreach (var t in Model.Items)
                    {
                        <tr>
                            <td><a asp-action="Details" asp-route-id="@t.RentalTransactionID">#@t.RentalTransactionID</a></td>
                            <td>@t.CustomerName</td>
                            <td>@(t.ReservationID > 0 ? $"#{t.ReservationID}" : "—")</td>
                            <td>@t.CheckoutDate.ToString("yyyy-MM-dd")</td>
                            <td>@t.ExpectedReturnDate.ToString("yyyy-MM-dd")</td>
                            <td>@(t.ReturnDate?.ToString("yyyy-MM-dd") ?? "—")</td>
                            <td class="text-end">&#8369;@t.TotalAmount.ToString("N2")</td>
                            <td><partial name="_StatusBadge" model="t.Status" /></td>
                            <td class="text-end">
                                <a asp-action="Details" asp-route-id="@t.RentalTransactionID" class="btn btn-sm btn-outline-primary" title="Open"><i class="bi bi-box-arrow-up-right"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (Model.TotalPages > 1)
        {
            <div class="card-footer d-flex justify-content-between align-items-center">
                <small class="text-muted">
                    Showing @((Model.Page - 1) * Model.PageSize + 1)–@(Math.Min(Model.Page * Model.PageSize, Model.TotalCount))
                    of @Model.TotalCount transaction@(Model.TotalCount == 1 ? "" : "s")
                </small>
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        <li class="page-item @(Model.Page <= 1 ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249; Prev</a>
                        </li>
                        @for (var p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.Page ? "active" : "")">
                                <a class="page-link" href="@Model.PageUrl(p)">@p</a>
                            </li>
                        }
                        <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">Next &#8250;</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
        else if (Model.TotalCount > 0)
        {
            <div class="card-footer text-muted small">
                Showing @Model.TotalCount transaction@(Model.TotalCount == 1 ? "" : "s")
            </div>
        }
    </div>
}
