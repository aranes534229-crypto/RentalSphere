@{
    ViewData["Title"] = "Forbidden";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card shadow-sm">
            <div class="card-body p-5">
                <i class="bi bi-shield-exclamation text-danger" style="font-size: 3rem;"></i>
                <h2 class="mt-3">403 — Forbidden</h2>
                <p class="text-muted">A controller action rejected your request because your role isn't allowed to perform that operation.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    <i class="bi bi-house"></i> Back to Dashboard
                </a>
            </div>
        </div>
    </div>
</div>
