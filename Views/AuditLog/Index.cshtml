@model RentalSphere.Identity.Models.ViewModels.AuditLogIndexViewModel
@{
    ViewData["Title"] = "Audit log";
    var search = Model.Search;
    var hasFilter = !string.IsNullOrWhiteSpace(search);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h2 class="mb-0"><i class="bi bi-journal-text"></i> Audit log</h2>
        <small class="text-muted">Full trail of privileged actions performed by Admin and Staff users.</small>
    </div>
    <span class="badge bg-secondary">@Model.TotalCount total entries</span>
</div>

@if (TempData["Success"] is string s) { <div class="alert alert-success alert-dismissible fade show">@s<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }
@if (TempData["Error"] is string e) { <div class="alert alert-danger alert-dismissible fade show">@e<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div> }

<form method="get" class="mb-3 audit-log-filter-form" id="auditLogFilterForm">
    <div class="row g-2 align-items-center">
        <div class="col-md-4">
            <input type="search" name="search" value="@search" class="form-control audit-log-filter-control"
                   placeholder="Filter by action, entity, ID..." aria-label="Filter audit log" />
        </div>
        <div class="col-md-2 d-flex gap-1">
            @if (hasFilter)
            {
                <a asp-action="Index" class="btn btn-outline-secondary" title="Clear filters"><i class="bi bi-x-lg"></i></a>
            }
        </div>
    </div>
    <input type="hidden" name="pageSize" id="auditLogPageSize" value="@Model.PageSize" />
</form>

<div class="audit-log-main-card">
    <div class="table-responsive">
        <table class="table table-hover mb-0 align-middle audit-log-table">
            <thead class="audit-log-table-header">
                <tr>
                    <th>Timestamp</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Items.Any())
                {
                    <tr><td colspan="6" class="p-0">
                        <div class="text-center text-muted py-5">
                            <i class="bi bi-journal-text" style="font-size: 2.5rem;"></i>
                            <p class="mb-1 mt-2">@(hasFilter ? "No audit entries match your filter." : "No audit entries found.")</p>
                            @if (hasFilter)
                            {
                                <a asp-action="Index" asp-route-pageSize="@Model.PageSize" class="btn btn-sm btn-outline-secondary mt-2">
                                    <i class="bi bi-x-lg"></i> Show all
                                </a>
                            }
                        </div>
                    </td></tr>
                }
                @foreach (var a in Model.Items)
                {
                    <tr>
                        <td><a href="#" class="audit-log-name-link">#@a.AuditLogID</a></td>
                        <td><small>@(Model.ActorLookup.TryGetValue(a.ActorUserId, out var email) ? email : a.ActorUserId)</small></td>
                        <td>@{
                    // AuditLog action: green for create/confirm/checkout/return
                    // (constructive), red for delete/cancel/update (destructive),
                    // neutral default otherwise. No badge — plain inline text.
                    var lower = a.Action.ToLowerInvariant();
                    var actionClass = lower.Contains("delete") || lower.Contains("cancel")
                            ? "text-danger"
                            : lower.Contains("create") || lower.Contains("confirm")
                                || lower.Contains("checkout") || lower.Contains("return")
                                    ? "text-success"
                                    : "text-muted";
                }
                <span class="@actionClass">@a.Action</span></td>
                        <td>@a.EntityName</td>
                        <td><code>@a.EntityId</code></td>
                        <td><small class="text-muted">@(a.IpAddress ?? "—")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (Model.TotalPages > 1)
    {
        <div class="card-footer d-flex justify-content-between align-items-center py-3">
            <div class="d-flex align-items-center">
                <label for="pageSizeSelect" class="me-2 mb-0 fw-medium">Show:</label>
                <select id="pageSizeSelect" class="form-select form-select-sm" aria-label="Rows per page"
                        onchange="document.getElementById('auditLogPageSize').value = this.value; document.getElementById('auditLogFilterForm').submit();">
                    @foreach (var ps in Model.PageSizes)
                    {
                        <option value="@ps.Value" selected="@(ps.Value == Model.PageSize.ToString() ? true : false)">@ps.Text</option>
                    }
                </select>
            </div>
            <nav>
                <div class="d-flex align-items-center audit-log-pagination" style="gap: 6px;">
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(1)">&laquo;</a>
                    <a class="pagination-pill @(Model.Page <= 1 ? "disabled" : "")" href="@Model.PageUrl(Math.Max(1, Model.Page - 1))">&#8249;</a>
                    @{
                        // Render a windowed set of page numbers with ellipsis
                        // separators between non-adjacent groups so the strip
                        // doesn't sprawl when there are many pages.
                        const int window = 1; // pages around the current one
                        int first = 1;
                        int last = Model.TotalPages;
                        int start = Math.Max(first, Model.Page - window);
                        int end = Math.Min(last, Model.Page + window);
                    }
                    @for (var p = first; p <= last; p++)
                    {
                        if (p == Model.Page)
                        {
                            <a class="pagination-pill active" href="#">@p</a>
                        }
                        else if (p >= start && p <= end)
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                        else if (p == first && start > first + 1)
                        {
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                            <span class="pagination-ellipsis" aria-hidden="true">…</span>
                            p = end;
                        }
                        else if (p == last && end < last - 1)
                        {
                            <span class="pagination-ellipsis" aria-hidden="true">…</span>
                            <a class="pagination-pill" href="@Model.PageUrl(p)">@p</a>
                        }
                    }
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Math.Min(Model.TotalPages, Model.Page + 1))">&#8250;</a>
                    <a class="pagination-pill @(Model.Page >= Model.TotalPages ? "disabled" : "")" href="@Model.PageUrl(Model.TotalPages)">&raquo;</a>
                </div>
            </nav>
        </div>
    }
    else if (Model.TotalCount > 0)
    {
        <div class="card-footer text-muted small">
            Showing @Model.TotalCount audit entry@(Model.TotalCount == 1 ? "" : "s")
        </div>
    }
</div>
