@model List<RentalSphere.Identity.Models.AuditLog>
@{
    ViewData["Title"] = "Audit log";
    var search = ViewData["Search"] as string;
    var page = (int)(ViewData["Page"] ?? 1);
    var totalPages = (int)(ViewData["TotalPages"] ?? 1);
    var total = (int)(ViewData["Total"] ?? 0);
    var actors = ViewData["ActorLookup"] as Dictionary<string, string> ?? new();
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="mb-0"><i class="bi bi-journal-text"></i> Audit log</h2>
    <span class="badge bg-secondary">@total total entries</span>
</div>

<form method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@search" class="form-control" placeholder="Filter by action, entity, ID..." />
        <button class="btn btn-outline-secondary" type="submit"><i class="bi bi-search"></i></button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-outline-secondary"><i class="bi bi-x"></i> Clear</a>
        }
    </div>
</form>

<div class="card">
    <div class="table-responsive">
        <table class="table table-striped table-hover mb-0 align-middle">
            <thead class="table-dark">
                <tr>
                    <th>Timestamp</th>
                    <th>Actor</th>
                    <th>Action</th>
                    <th>Entity</th>
                    <th>Entity ID</th>
                    <th>IP</th>
                </tr>
            </thead>
            <tbody>
                @if (!Model.Any())
                {
                    <tr><td colspan="6" class="text-center text-muted py-4">No audit entries.</td></tr>
                }
                @foreach (var a in Model)
                {
                    <tr>
                        <td><small>@a.Timestamp.ToString("yyyy-MM-dd HH:mm:ss")</small></td>
                        <td><small>@(actors.TryGetValue(a.ActorUserId, out var email) ? email : a.ActorUserId)</small></td>
                        <td><span class="badge bg-info text-dark">@a.Action</span></td>
                        <td>@a.EntityName</td>
                        <td><code>@a.EntityId</code></td>
                        <td><small class="text-muted">@(a.IpAddress ?? "—")</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            <li class="page-item @(page <= 1 ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(page - 1)" asp-route-search="@search">Previous</a>
            </li>
            <li class="page-item disabled"><span class="page-link">Page @(page) of @totalPages</span></li>
            <li class="page-item @(page >= totalPages ? "disabled" : "")">
                <a class="page-link" asp-action="Index" asp-route-page="@(page + 1)" asp-route-search="@search">Next</a>
            </li>
        </ul>
    </nav>
}
